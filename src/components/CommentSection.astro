---
import { getLangFromRequest } from '../utils/lang';
import { ui, defaultLang } from '../i18n/ui';

const { targetId } = Astro.props;
const user = Astro.locals.user;
const isLoggedIn = !!user;
const currentUserId = user?.id || '';
const currentUserRole = user?.role || '';

const lang = getLangFromRequest(Astro);
const t = ui[lang as keyof typeof ui] || ui[defaultLang];
---

<div class="border-t border-gray-100 dark:border-slate-800 pt-10 mt-12 comment-section" data-target-id={targetId} data-current-user-role={currentUserRole}>
  <div id="comments-list" class="space-y-6 mb-12">
    <div class="text-center text-gray-400 dark:text-slate-500 py-8 flex flex-col items-center justify-center">
      <svg class="animate-spin h-6 w-6 text-gray-300 dark:text-slate-600 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
      <span class="text-sm">{t['comments.loading']}</span>
    </div>
  </div>

  <h3 class="text-2xl font-bold mb-8 text-gray-900 dark:text-slate-100 border-b border-gray-50 dark:border-slate-800/50 pb-4">{t['comments.title']}</h3>
  
  {isLoggedIn ? (
    <div class="bg-gray-50 dark:bg-slate-800/50 p-4 rounded-2xl border border-gray-100 dark:border-slate-700/50">
      <textarea id="comment-input" class="w-full p-4 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-900 dark:text-slate-100 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all resize-none text-sm shadow-sm" rows="3" placeholder={t['comments.placeholder']}></textarea>
      <div class="flex justify-end mt-3 gap-2">
        <button id="cancel-reply" class="hidden text-sm text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-300 px-4 py-2">{t['comments.cancel_reply']}</button>
        <button id="submit-comment" class="bg-blue-600 dark:bg-blue-500 hover:bg-blue-700 dark:hover:bg-blue-600 text-white font-bold py-2.5 px-6 rounded-xl shadow-md shadow-blue-500/20 transition-all active:scale-95 text-sm">
          {t['comments.submit']}
        </button>
      </div>
    </div>
  ) : (
    <div class="bg-blue-50/50 dark:bg-blue-900/10 p-8 rounded-2xl text-center border border-blue-100 dark:border-blue-900/30 border-dashed">
      <p class="text-blue-800/60 dark:text-blue-400/80 font-medium mb-4">{t['comments.login_to_discuss']}</p>
      <a href="/login" class="inline-block bg-white dark:bg-slate-800 hover:bg-gray-50 dark:hover:bg-slate-700 text-blue-600 dark:text-blue-400 font-bold py-2 px-8 rounded-full border border-blue-200 dark:border-slate-700 shadow-sm transition-all hover:scale-105">{t['comments.go_to_login']}</a>
    </div>
  )}

  <!-- Custom Delete Confirmation Modal -->
  <div id="delete-confirm-modal" class="fixed inset-0 z-[100] flex items-center justify-center hidden bg-gray-900/40 backdrop-blur-sm transition-opacity opacity-0">
    <div id="delete-confirm-content" class="bg-white dark:bg-slate-900 p-6 rounded-2xl shadow-xl border border-gray-100 dark:border-slate-800 max-w-sm w-full mx-4 transform scale-95 transition-all duration-200">
      <div class="flex items-center mb-4">
        <div class="bg-red-50 dark:bg-red-900/30 p-2 rounded-full mr-3">
          <svg class="w-6 h-6 text-red-500 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-slate-100">{t['auth.tip'] || 'Notice'}</h3>
      </div>
      <p class="text-gray-600 dark:text-slate-400 text-sm leading-relaxed mb-6">{t['comments.delete_confirm']}</p>
      <div class="flex justify-end space-x-3">
        <button id="cancel-delete-btn" class="px-4 py-2 text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-300 transition-colors">
          {lang === 'zh' ? '取消' : 'Cancel'}
        </button>
        <button id="confirm-delete-btn" class="bg-red-500 dark:bg-red-600 text-white px-6 py-2 text-sm font-bold rounded-xl hover:bg-red-600 dark:hover:bg-red-700 transition-all active:scale-95 shadow-lg shadow-red-500/20">
          {t['comments.delete']}
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ 
  t_reply: t['comments.reply'],
  t_delete: t['comments.delete'],
  t_empty: t['comments.empty'],
  t_load_failed: t['comments.load_failed'],
  t_submitting: t['comments.submitting'],
  t_submit: t['comments.submit'],
  t_success: t['comments.success'],
  t_placeholder: t['comments.placeholder'],
  t_login_first: t['comments.login_first'],
  t_like_success: t['comments.like_success'],
  t_like_cancel: t['comments.like_cancel'],
  t_delete_confirm: t['comments.delete_confirm'],
  t_delete_success: t['comments.delete_success'],
  t_delete_failed: t['comments.delete_failed'],
  t_network_error: t['comments.network_error'],
  t_empty_content: t['comments.empty_content'],
  t_reply_to: t['comments.reply_to']
}}>
  // 使用模块化脚本，每个组件实例都会执行
  const sections = document.querySelectorAll('.comment-section');
  
  sections.forEach(section => {
    const targetId = section.getAttribute('data-target-id');
    const currentUserRole = section.getAttribute('data-current-user-role');
    
    const submitBtn = section.querySelector('#submit-comment');
    const input = section.querySelector('#comment-input');
    const cancelReplyBtn = section.querySelector('#cancel-reply');
    const list = section.querySelector('#comments-list');
    
    let currentParentId = null;
    let isSubmitting = false;

      function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Helper func to render a single comment block
    function renderComment(c, isSub = false) {
      const d = new Date(c.created_at);
      const timeStr = `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
      const canDelete = !c.is_deleted && (currentUserRole === 'admin' || c.is_own);
      const safeUsername = escapeHtml(c.username);
      const safeContent = escapeHtml(c.content);
      const initialLetter = c.username ? escapeHtml(c.username.charAt(0).toUpperCase()) : '?';
      
      let html = `
        <div class="flex space-x-3 ${isSub ? 'mt-4' : 'bg-white dark:bg-slate-900'} comment-item" data-id="${escapeHtml(c.id)}" data-username="${safeUsername}">
          <div class="${isSub ? 'w-8 h-8 text-xs' : 'w-10 h-10'} rounded-full ${c.is_deleted ? 'bg-gray-100 dark:bg-slate-800 text-gray-400 dark:text-slate-500' : 'bg-gradient-to-br from-blue-100 to-blue-50 dark:from-blue-900/30 dark:to-blue-900/10 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-900/50'} flex-shrink-0 flex items-center justify-center font-black shadow-inner">
            ${c.is_deleted ? '<svg class="w-1/2 h-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>' : initialLetter}
          </div>
          <div class="flex-1">
            <div class="${isSub ? 'bg-gray-50 dark:bg-slate-800/30' : 'bg-gray-50/50 dark:bg-slate-800/50'} rounded-2xl rounded-tl-none p-4 border border-gray-100 dark:border-slate-700/50 transition-colors hover:bg-gray-50 dark:hover:bg-slate-800/80">
              <div class="flex justify-between items-center mb-1">
                <span class="font-bold ${c.is_deleted ? 'text-gray-400 dark:text-slate-500' : 'text-gray-900 dark:text-slate-100'} text-sm">${safeUsername}</span>
                <span class="text-xs text-gray-400 dark:text-slate-500">${timeStr}</span>
              </div>
              <p class="${c.is_deleted ? 'text-gray-400 dark:text-slate-500 italic' : 'text-gray-700 dark:text-slate-300'} whitespace-pre-wrap text-sm leading-relaxed">${safeContent}</p>
              
              <div class="flex items-center gap-4 mt-3 text-xs text-gray-500 dark:text-slate-400">
                ${!c.is_deleted ? `
                  <button class="flex items-center space-x-1 hover:text-red-500 transition-colors comment-like-btn ${c.has_liked ? 'text-red-500' : ''}" data-id="${escapeHtml(c.id)}">
                    <svg class="w-3.5 h-3.5" fill="${c.has_liked ? 'currentColor' : 'none'}" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                    <span class="like-count-display">${c.like_count > 0 ? c.like_count : ''}</span>
                  </button>
                  <button class="hover:text-blue-600 transition-colors comment-reply-btn" data-id="${escapeHtml(c.id)}" data-username="${safeUsername}">${t_reply}</button>
                ` : ''}
                ${canDelete ? `
                  <button class="text-red-400 hover:text-red-600 transition-colors comment-delete-btn" data-id="${escapeHtml(c.id)}">${t_delete}</button>
                ` : ''}
                ${c.is_deleted && currentUserRole === 'admin' ? `
                  <button class="text-red-600 font-bold hover:underline transition-colors comment-hard-delete-btn" data-id="${escapeHtml(c.id)}">彻底清理</button>
                ` : ''}
              </div>
            </div>
            
            <!-- 子评论容器 -->
            ${c.replies && c.replies.length > 0 ? `
              <div class="ml-2 pl-4 border-l-2 border-gray-100 dark:border-slate-800 space-y-4">
                ${c.replies.map((reply) => renderComment(reply, true)).join('')}
              </div>
            ` : ''}
          </div>
        </div>
      `;
      return html;
    }

    async function loadComments() {
      if(!list) return;
      try {
        const res = await fetch(`/api/comments?post_id=${targetId}`);
        const data = await res.json();
        
        if(data.success) {
          if(data.comments.length === 0) {
            list.innerHTML = `<div class="text-center text-gray-400 dark:text-slate-500 py-12 bg-gray-50 dark:bg-slate-800/30 rounded-2xl border border-dashed border-gray-200 dark:border-slate-700">${t_empty}</div>`;
            return;
          }
          
          let html = '';
          data.comments.forEach((c) => {
            html += renderComment(c, false);
          });
          list.innerHTML = html;
          attachCommentEvents();
        }
      } catch(e) {
        list.innerHTML = `<div class="text-center text-red-500 py-4">${t_load_failed}</div>`;
      }
    }

    function attachCommentEvents() {
      if(!list) return;
      // 回复按钮
      const replyBtns = list.querySelectorAll('.comment-reply-btn');
      replyBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget;
          const id = target.getAttribute('data-id');
          const username = target.getAttribute('data-username');
          if(!input) {
            if(window.showToast) window.showToast('请先登录后再回复', 'error');
            return;
          }
          currentParentId = id;
          input.placeholder = `${t_reply_to} @${username}:`;
          input.focus();
          if(cancelReplyBtn) cancelReplyBtn.classList.remove('hidden');
        });
      });

      // 点赞按钮
      const likeBtns = list.querySelectorAll('.comment-like-btn');
      likeBtns.forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget;
          const id = target.getAttribute('data-id');
          if(isSubmitting) return;
          isSubmitting = true;
          try {
            const res = await fetch('/api/interactions', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ targetType: 'comment_like', targetId: id })
            });
            const data = await res.json();
            if(!data.success && data.error === '请先登录') {
              if(window.showToast) window.showToast(t_login_first, 'error');
              setTimeout(() => window.location.href = '/login', 1000);
              return;
            }
            if(data.success) {
              const span = target.querySelector('.like-count-display');
              let count = parseInt(span?.textContent || '0');
              if(data.action === 'added') {
                target.classList.add('text-red-500');
                target.querySelector('svg')?.setAttribute('fill', 'currentColor');
                if(span) span.textContent = String(count + 1);
                if(window.showToast) window.showToast(t_like_success, 'success');
              } else {
                target.classList.remove('text-red-500');
                target.querySelector('svg')?.setAttribute('fill', 'none');
                if(span) span.textContent = count - 1 > 0 ? String(count - 1) : '';
                if(window.showToast) window.showToast(t_like_cancel);
              }
            }
          } finally {
            setTimeout(() => { isSubmitting = false; }, 2000); // 2s throttle
          }
        });
      });

      // 删除按钮
      const deleteModal = section.querySelector('#delete-confirm-modal');
      const deleteContent = section.querySelector('#delete-confirm-content');
      const confirmDeleteBtn = section.querySelector('#confirm-delete-btn');
      const cancelDeleteBtn = section.querySelector('#cancel-delete-btn');
      let pendingDeleteId = null;

      const deleteBtns = list.querySelectorAll('.comment-delete-btn');
      deleteBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          pendingDeleteId = e.currentTarget.getAttribute('data-id');
          deleteModal.classList.remove('hidden');
          setTimeout(() => {
            deleteModal.classList.remove('opacity-0');
            deleteContent.classList.replace('scale-95', 'scale-100');
          }, 10);
        });
      });

      cancelDeleteBtn?.addEventListener('click', () => {
        deleteModal.classList.add('opacity-0');
        deleteContent.classList.replace('scale-100', 'scale-95');
        setTimeout(() => deleteModal.classList.add('hidden'), 200);
        pendingDeleteId = null;
      });

      confirmDeleteBtn?.addEventListener('click', async () => {
        if(!pendingDeleteId || isSubmitting) return;
        const id = pendingDeleteId;
        isSubmitting = true;
        confirmDeleteBtn.disabled = true;
        confirmDeleteBtn.innerText = '...';

        try {
          const res = await fetch(`/api/comments/${id}`, { method: 'DELETE' });
          const data = await res.json();
          if(data.success) {
            if(window.showToast) window.showToast(t_delete_success, 'success');
            // 关闭弹窗
            cancelDeleteBtn.click();
            await loadComments();
          } else {
            if(window.showToast) window.showToast(data.error || t_delete_failed, 'error');
          }
        } catch(err) {
          if(window.showToast) window.showToast(t_network_error, 'error');
        } finally {
          isSubmitting = false;
          confirmDeleteBtn.disabled = false;
          confirmDeleteBtn.innerText = t_delete;
        }
      });

      // 彻底删除按钮 (管理员专用)
      const hardDeleteBtns = list.querySelectorAll('.comment-hard-delete-btn');
      hardDeleteBtns.forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget;
          const id = target.getAttribute('data-id');
          if(isSubmitting) return;
          isSubmitting = true;
          try {
            const res = await fetch(`/api/comments/${id}?hard=true`, { method: 'DELETE' });
            const data = await res.json();
            if(data.success) {
              if(window.showToast) window.showToast('评论已彻底从数据库移除', 'success');
              await loadComments();
            } else {
              if(window.showToast) window.showToast(data.error || '清理失败', 'error');
            }
          } catch(err) {
            if(window.showToast) window.showToast(t_network_error, 'error');
          } finally {
            isSubmitting = false;
          }
        });
      });
    }

    if(cancelReplyBtn) {
      cancelReplyBtn.addEventListener('click', () => {
        currentParentId = null;
        if(input) {
          input.placeholder = t_placeholder;
          input.value = "";
        }
        cancelReplyBtn.classList.add('hidden');
      });
    }

    if(submitBtn && input) {
      submitBtn.addEventListener('click', async () => {
        const content = input.value.trim();
        if(!content) {
          if(window.showToast) window.showToast(t_empty_content, 'error');
          return;
        }
        
        if(isSubmitting) return;
        isSubmitting = true;
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.textContent = t_submitting;
        submitBtn.classList.add('opacity-70');
        
        try {
          const res = await fetch('/api/comments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ postId: targetId, content, parentId: currentParentId })
          });
          const data = await res.json();
          
          if(data.success) {
            input.value = '';
            currentParentId = null;
            input.placeholder = t_placeholder;
            if(cancelReplyBtn) cancelReplyBtn.classList.add('hidden');
            if(window.showToast) window.showToast(t_success, 'success');
            await loadComments();
          } else {
            if(window.showToast) window.showToast(data.error || '提交失败', 'error');
          }
          } finally {
            setTimeout(() => {
              isSubmitting = false;
              submitBtn.removeAttribute('disabled');
              submitBtn.textContent = t_submit;
              submitBtn.classList.remove('opacity-70');
            }, 5000); // 5s submission throttle
          }
      });
    }

    // Init
    loadComments();
  });
</script>

