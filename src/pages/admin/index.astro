      // Modal management
      async function openModal(item = null) {
        modal.classList.remove('hidden');
        requestAnimationFrame(() => {
          modal.classList.remove('opacity-0');
          modalContent.classList.remove('scale-95');
        });

        await injectFormFields(item);
        
        const titles = { resources: [i18n['admin.create_resource'],i18n['admin.modal_edit_resource']], showcase: [i18n['admin.create_showcase'],i18n['admin.modal_edit_showcase']], news: [i18n['admin.create_news'],i18n['admin.modal_edit_news']], blog: [i18n['admin.create_blog'],i18n['admin.modal_edit_blog']], guestbook: ['',i18n['admin.modal_edit_message']], notifications: [i18n['admin.create_notification'],i18n['admin.modal_edit_notification']], users: ['',i18n['admin.modal_edit_user']], restrictions: [i18n['admin.create_restriction'],i18n['admin.modal_edit_restriction']], complaints: ['',i18n['admin.modal_process_complaint']] };
        if(item) {
          modalTitle.textContent = titles[currentTab][1];
          form.elements['id'].value = item.id || item.email || '';
        } else {
          modalTitle.textContent = titles[currentTab][0];
          form.elements['id'].value = '';
        }
      }

      function closeModal() {
        modal.classList.add('opacity-0');
        modalContent.classList.add('scale-95');
        setTimeout(() => {
          modal.classList.add('hidden');
        }, 300);
      }

      document.getElementById('btn-create').addEventListener('click', () => openModal());
      document.querySelectorAll('.modal-close, .modal-overlay').forEach(el => {
        el.addEventListener('click', closeModal);
      });

      // Form Submission
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const btnSubmit = document.getElementById('btn-submit');
        btnSubmit.disabled = true;
        btnSubmit.textContent = i18n['admin.btn_saving'];

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());
        const id = payload.id;
        delete payload.id; // remove from body if creating
        
        if(currentTab === 'resources' && payload.tags) {
          try { JSON.parse(payload.tags); } 
          catch(err) {
            if(window.showToast) window.showToast(i18n['admin.msg_invalid_tags'], 'error');
            btnSubmit.disabled = false;
            btnSubmit.textContent = i18n['admin.btn_save'];
            return;
          }
        }

        let method, url;
        if (currentTab === 'users') {
          method = 'PUT';
          url = `/api/admin/users/${id}`;
        } else if (currentTab === 'guestbook') {
          method = 'PUT';
          url = `/api/admin/guestbook/${id}`;
        } else if (currentTab === 'restrictions') {
          if (id) { method = 'PUT'; url = `/api/admin/restrictions/${encodeURIComponent(id)}`; }
          else { method = 'POST'; url = '/api/admin/restrictions'; payload.expires_at = payload.expires_at ? payload.expires_at.replace('T',' ') + ':00' : ''; }
        } else if (currentTab === 'complaints') {
          method = 'PUT';
          url = '/api/admin/complaints';
          payload.id = id;
        } else if (currentTab === 'notifications') {
          method = id ? 'PUT' : 'POST';
          url = id ? `/api/admin/notifications/${id}` : '/api/admin/notifications';
          if(document.getElementById('check-all-users').checked) {
            payload.target_user_id = null;
          } else {
            payload.target_user_id = formData.getAll('target_user_id');
            if(payload.target_user_id.length === 0 && !id) {
               if(window.showToast) window.showToast(i18n['admin.msg_select_user'], 'error');
               btnSubmit.disabled = false;
               btnSubmit.textContent = i18n['admin.btn_save'];
               return;
            }
            // If editing, only take the first one (or keep it as it is)
            if(id) payload.target_user_id = payload.target_user_id[0];
          }
        } else {
          method = id ? 'PUT' : 'POST';
          const baseUrls = { resources: '/api/admin/resources', showcase: '/api/admin/showcase', news: '/api/admin/news', blog: '/api/admin/blog' };
          const baseUrl = baseUrls[currentTab] || '/api/admin/resources';
          url = id ? `${baseUrl}/${id}` : baseUrl;
        }

        try {
          const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if(data.success) {
            if(window.showToast) window.showToast(id ? i18n['admin.msg_update_success'] : i18n['admin.msg_create_success'], 'success');
            closeModal();
            loadData();
          } else {
            if(window.showToast) window.showToast(data.error || i18n['admin.msg_save_failed'], 'error');
          }
        } catch(err) {
          if(window.showToast) window.showToast(i18n['admin.msg_network_error'], 'error');
        } finally {
          btnSubmit.disabled = false;
          btnSubmit.textContent = i18n['admin.btn_save'];
        }
      });

      // Init
      switchTab(currentTab);
    });
  </script>
</Layout>
