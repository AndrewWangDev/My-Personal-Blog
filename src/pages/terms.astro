const cur = content[lang as keyof typeof content] || content.zh;
---

<Layout title={`${cur.title} | Andrew Wang Dev`}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 pb-24">
    <div class="mb-12 border-b border-gray-100 dark:border-slate-800 pb-8 text-center">
      <h1 class="text-4xl font-black text-gray-900 dark:text-slate-100 tracking-tight mb-4 uppercase">{cur.title}</h1>
      <p class="text-lg text-gray-500 dark:text-slate-400 font-medium">{t['footer.terms']}</p>
    </div>

    <article class="prose prose-blue prose-lg dark:prose-invert max-w-none bg-white dark:bg-slate-900 p-8 md:p-12 rounded-[2rem] shadow-sm border border-gray-100 dark:border-slate-800">
      <p class="text-gray-500 dark:text-slate-400 text-sm">{cur.updateDate}<br/>{t['footer.contact']}：<span class="contact-email-trigger font-mono font-medium text-blue-600 dark:text-blue-400 cursor-pointer underline decoration-dotted" title="Click to copy email">support@andrewwangdev.com</span></p>

      {cur.sections.map(s => (
        <section class="mt-8">
          <h3 class="font-bold text-gray-900 dark:text-slate-100 mb-4">{s.h}</h3>
          <div set:html={s.p} class="text-gray-600 dark:text-slate-300 leading-relaxed" />
        </section>
      ))}
    </article>
  </main>
</Layout>

<script is:inline define:vars={{ toastEmailCopiedMsg: t['toast.email_copied'] }}>
  document.querySelectorAll('.contact-email-trigger').forEach(el => {
    el.addEventListener('click', async () => {
      const email = ['support', '@', 'andrewwangdev.com'].join('');
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(email);
        } else {
          const input = document.createElement('input');
          input.value = email;
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
        }
        if (window.showToast) {
          const msg = toastEmailCopiedMsg || 'Email copied: ';
          window.showToast(`${msg}${email}`, 'success');
        }
      } catch (e) {
        if (window.showToast) {
          window.showToast(email, 'info');
        }
      }
    });
  });
</script>

