      function calcStrength(pw) {
        let score = 0;
        if (!pw) return 0;
        if (pw.length >= 6) score++;
        if (pw.length >= 10) score++;
        if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) score++;
        if (/\d/.test(pw)) score++;
        if (/[^a-zA-Z0-9]/.test(pw)) score++;
        return Math.min(score, 5);
      }
      const strColors = ['', '#ef4444', '#f97316', '#eab308', '#22c55e', '#06b6d4'];
      const acctPwInput = document.getElementById('acct-new-password');
      if (acctPwInput) {
        acctPwInput.addEventListener('input', () => {
          const s = calcStrength(acctPwInput.value);
          for (let i = 1; i <= 5; i++) {
            const bar = document.getElementById('acct-str-' + i);
            bar.style.backgroundColor = i <= s ? strColors[s] : '#e5e7eb';
          }
          const label = document.getElementById('acct-str-label');
          label.textContent = s > 0 ? i18n.pwd_strength + i18n.str_labels[s-1] : '';
          label.style.color = strColors[s] || '#9ca3af';
        });
      }

      // ===== OAuth Status & Management =====
      const btnPrimaryStyle = 'inline-flex items-center px-3.5 py-1.5 text-xs font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 hover:bg-blue-100 dark:hover:bg-blue-900/60 rounded-xl transition-all shadow-sm';
      const btnDangerStyle = 'inline-flex items-center px-3.5 py-1.5 text-xs font-semibold text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-950/40 hover:bg-red-100 dark:hover:bg-red-900/60 rounded-xl transition-all shadow-sm';

      let googleTokenClient = null;

      function getGoogleTokenClient() {
        if (googleTokenClient) return googleTokenClient;
        if (!window.google?.accounts?.oauth2 || !googleClientId) return null;

        try {
          googleTokenClient = google.accounts.oauth2.initTokenClient({
            client_id: googleClientId,
            scope: 'openid email profile',
            callback: async (resp) => {
              if (resp.error) {
                if (resp.error !== 'popup_closed_by_user') {
                  customAlert(i18n.notice, resp.error_description || resp.error, 'error');
                }
                return;
              }
              if (resp.access_token) {
                try {
                  const res = await fetch('/api/auth/google', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ access_token: resp.access_token, action: 'bind' })
                  });
                  const data = await res.json();
                  if (res.ok && data.success) {
                    if (window.showToast) window.showToast(data.message || i18n.google_bind_success, 'success');
                    loadOAuthStatus();
                  } else {
                    customAlert(i18n.notice, data.error || '绑定失败', 'error');
                  }
                } catch(e) {
                  customAlert(i18n.notice, i18n.network_error || '网络错误', 'error');
                }
              }
            }
          });
          return googleTokenClient;
        } catch (err) {
          console.error('Google OAuth init error:', err);
          return null;
        }
      }

      async function loadOAuthStatus() {
        try {
          getGoogleTokenClient();
          const res = await fetch('/api/account/oauth/status');
          const data = await res.json();
          if (!data.success) return;

          const googleAcc = data.accounts.find(a => a.provider === 'google');
          const githubAcc = data.accounts.find(a => a.provider === 'github');

          // Google Slot
          const googleStatusText = document.getElementById('google-status-text');
          const googleActionSlot = document.getElementById('google-action-slot');
          if (googleAcc) {
            googleStatusText.innerText = `${googleAcc.provider_email || i18n.connected}`;
            googleStatusText.className = 'text-xs text-emerald-600 dark:text-emerald-400 font-medium';
            googleActionSlot.innerHTML = `<button type="button" onclick="unbindOAuth('google')" class="${btnDangerStyle}">${i18n.unbind || '解绑'}</button>`;
          } else {
            googleStatusText.innerText = i18n.not_connected || '未绑定';
            googleStatusText.className = 'text-xs text-gray-500 dark:text-slate-400';
            googleActionSlot.innerHTML = `<button type="button" onclick="bindGoogle()" class="${btnPrimaryStyle}">${i18n.bind || '立即绑定'}</button>`;
            getGoogleTokenClient();
          }

          // GitHub Slot
          const githubStatusText = document.getElementById('github-status-text');
          const githubActionSlot = document.getElementById('github-action-slot');
          if (githubAcc) {
            githubStatusText.innerText = `${githubAcc.provider_email || i18n.connected}`;
            githubStatusText.className = 'text-xs text-emerald-600 dark:text-emerald-400 font-medium';
            githubActionSlot.innerHTML = `<button type="button" onclick="unbindOAuth('github')" class="${btnDangerStyle}">${i18n.unbind || '解绑'}</button>`;
          } else {
            githubStatusText.innerText = i18n.not_connected || '未绑定';
            githubStatusText.className = 'text-xs text-gray-500 dark:text-slate-400';
            githubActionSlot.innerHTML = `<a href="/api/auth/github?action=bind" class="${btnPrimaryStyle}">${i18n.bind || '立即绑定'}</a>`;
          }
        } catch(e) {
          console.error('Failed to load OAuth status:', e);
        }
      }

      window.unbindOAuth = async function(provider) {
        const confirmed = await customConfirm(
          i18n.notice || '提示',
          i18n.unbind_confirm || '确定要解绑该账号吗？',
          i18n.unbind || '解绑',
          'danger'
        );
        if (!confirmed) return;

        try {
          const res = await fetch('/api/account/oauth/unbind', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ provider })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            if (window.showToast) window.showToast(data.message, 'success');
            loadOAuthStatus();
          } else {
            customAlert(i18n.notice, data.error || i18n.unbind_failed, 'error');
          }
        } catch(e) {
          customAlert(i18n.notice, i18n.network_error || '网络错误', 'error');
        }
      };

      window.bindGoogle = function() {
        if (!googleClientId) {
          customAlert(i18n.notice, 'Google Client ID 未配置', 'error');
          return;
        }

        const client = getGoogleTokenClient();
        if (client) {
          client.requestAccessToken({ prompt: 'select_account' });
        } else {
          let attempts = 0;
          const timer = setInterval(() => {
            attempts++;
            const c = getGoogleTokenClient();
            if (c) {
              clearInterval(timer);
              c.requestAccessToken({ prompt: 'select_account' });
            } else if (attempts > 10) {
              clearInterval(timer);
              customAlert(i18n.notice, i18n.google_loading || 'Google 服务加载中，请稍后再试', 'warning');
            }
          }, 200);
        }
      };

      loadOAuthStatus();
      window.addEventListener('load', () => getGoogleTokenClient());

      // ===== Passkeys Management =====
      async function loadPasskeys() {
        const container = document.getElementById('passkeys-list');
        try {
          const res = await fetch('/api/account/passkeys');
          const data = await res.json();
          if (data.success && data.passkeys.length > 0) {
            container.innerHTML = data.passkeys.map(pk => {
              const createdDate = new Date(pk.created_at).toLocaleDateString();
              const lastUsed = pk.last_used_at ? new Date(pk.last_used_at).toLocaleDateString() : (i18n.never || 'Never');
              return `
                <div class="flex items-center justify-between p-3.5 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl">
                  <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                    </div>
                    <div>
                      <h4 class="text-sm font-semibold text-gray-900 dark:text-slate-100">${pk.name}</h4>
                      <p class="text-xs text-gray-400 dark:text-slate-500">${createdDate}</p>
                    </div>
                  </div>
                  <button type="button" onclick="deletePasskey('${pk.id}')" class="px-2.5 py-1 text-xs font-semibold text-red-500 hover:text-red-700 hover:bg-red-50 dark:hover:bg-red-950/40 rounded-lg transition-all">${i18n.delete || '删除'}</button>
                </div>
              `;
            }).join('');
          } else {
            container.innerHTML = `<div class="text-center py-6 text-gray-400 text-xs">${i18n.no_passkeys || '暂未添加通行密钥'}</div>`;
          }
        } catch(e) {
          container.innerHTML = `<div class="text-center py-6 text-red-400 text-xs">${i18n.load_failed}</div>`;
        }
      }

      window.deletePasskey = async function(id) {
        const confirmed = await customConfirm(
          i18n.notice || '提示',
          i18n.delete_passkey_confirm || '确定要删除此通行密钥吗？',
          i18n.delete || '删除',
          'danger'
        );
        if (!confirmed) return;

        try {
          const res = await fetch('/api/account/passkeys', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            if (window.showToast) window.showToast(data.message || '通行密钥已移除', 'success');
            loadPasskeys();
          } else {
            customAlert(i18n.notice, data.error || '删除失败', 'error');
          }
        } catch(e) {
          customAlert(i18n.notice, i18n.network_error || '网络错误', 'error');
        }
      };

      document.getElementById('btn-add-passkey')?.addEventListener('click', async () => {
        if (!window.PublicKeyCredential) {
          customAlert(i18n.notice, i18n.webauthn_unsupported, 'warning');
          return;
        }

        const name = await customPrompt(
          i18n.passkeys || '通行密钥',
          i18n.passkey_name_prompt || '请输入此通行密钥的名称（例如: MacBook Touch ID）:',
          'My Device Passkey',
          'MacBook Touch ID / Windows Hello'
        );
        if (!name) return; // user cancelled

        try {
          const optRes = await fetch('/api/auth/passkey/register-options', { method: 'POST' });
          const optData = await optRes.json();
          if (!optData.success) {
            customAlert(i18n.notice, optData.error || '获取注册参数失败', 'error');
            return;
          }

          const options = optData.options;
          options.challenge = Uint8Array.from(atob(options.challenge.replace(/-/g, '+').replace(/_/g, '/')), c => c.charCodeAt(0));
          options.user.id = Uint8Array.from(atob(options.user.id.replace(/-/g, '+').replace(/_/g, '/')), c => c.charCodeAt(0));

          const credential = await navigator.credentials.create({ publicKey: options });
          if (!credential) return;

          function bufferToBase64Url(buf) {
            const bytes = new Uint8Array(buf);
            let binary = '';
            for (let i = 0; i < bytes.byteLength; i++) binary += String.fromCharCode(bytes[i]);
            return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
          }

          let publicKeySpki = '';
          if (typeof credential.response.getPublicKey === 'function') {
            const spkiBuf = credential.response.getPublicKey();
            if (spkiBuf) publicKeySpki = bufferToBase64Url(spkiBuf);
          }

          const verifyPayload = {
            id: credential.id,
            rawId: bufferToBase64Url(credential.rawId),
            name: name.trim() || 'My Passkey',
            publicKeySpki,
            response: {
              clientDataJSON: bufferToBase64Url(credential.response.clientDataJSON),
              attestationObject: bufferToBase64Url(credential.response.attestationObject),
              transports: credential.response.getTransports ? credential.response.getTransports() : ['internal']
            }
          };

          const verifyRes = await fetch('/api/auth/passkey/register-verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(verifyPayload)
          });

          const verifyData = await verifyRes.json();
          if (verifyRes.ok && verifyData.success) {
            if (window.showToast) window.showToast(verifyData.message || i18n.passkey_add_success, 'success');
            loadPasskeys();
          } else {
            customAlert(i18n.notice, verifyData.error || '通行密钥注册失败', 'error');
          }

        } catch(err) {
          if (err.name !== 'NotAllowedError') {
            customAlert(i18n.notice, '创建通行密钥失败: ' + err.message, 'error');
          }
        }
      });

      loadPasskeys();

      // Check URL search params for toast messages
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('success') && window.showToast) {
        window.showToast(urlParams.get('success'), 'success');
        history.replaceState(null, '', window.location.pathname);
      } else if (urlParams.has('error')) {
        customAlert(i18n.notice, decodeURIComponent(urlParams.get('error')), 'error');
        history.replaceState(null, '', window.location.pathname);
      }

      // Logout button handler
      document.getElementById('btn-logout-account')?.addEventListener('click', async () => {
        const confirmed = await customConfirm(
          i18n.notice || '提示',
          i18n.logout_confirm || '确定要退出当前登录吗？',
          i18n.logout || '退出登录',
          'danger'
        );
        if (!confirmed) return;
        try {
          await fetch('/api/auth/logout', { method: 'POST' });
          localStorage.removeItem('account_tab');
          window.location.href = '/login';
        } catch(e) {
          window.location.href = '/login';
        }
      });

      let userHasPassword = Boolean(hasPassword);
      const passwordForm = document.getElementById('password-form');
      passwordForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('btn-save-password');
        btn.disabled = true;
        btn.textContent = i18n.pwd_updating;
        const formData = new FormData(passwordForm);
        const payload = Object.fromEntries(formData.entries());
        if (!userHasPassword) {
          delete payload.oldPassword;
        }

        try {
          const res = await fetch('/api/account/password', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (data.success) {
            if(window.showToast) window.showToast(data.message || (userHasPassword ? i18n.pwd_success : (i18n.pwd_set_success || '密码设置成功')), 'success');
            passwordForm.reset();
            userHasPassword = true;
            document.getElementById('pwd-status-banner')?.classList.add('hidden');
            const oldPwdGroup = document.getElementById('group-old-password');
            if (oldPwdGroup) {
              oldPwdGroup.classList.remove('hidden');
              const oldPwdInput = document.getElementById('acct-old-password');
              if (oldPwdInput) oldPwdInput.required = true;
            }
          } else {
            if(window.showToast) window.showToast(data.error || i18n.update_failed, 'error');
          }
        } catch (err) {
          if(window.showToast) window.showToast(i18n.network_error, 'error');
        } finally {
          btn.disabled = false;
          btn.textContent = userHasPassword ? i18n.update_pwd : (i18n.set_pwd || '设置密码');
        }
      });

      const modal = document.getElementById('delete-modal');
      const modalContent = modal.querySelector('.modal-content');
      const btnDeleteOpen = document.getElementById('btn-delete-account');
      const checkbox = document.getElementById('confirm-delete-checkbox');
      const btnConfirmDelete = document.getElementById('btn-confirm-delete');

      function openModal() {
        modal.classList.remove('hidden');
        setTimeout(() => {
          modal.classList.remove('opacity-0');
          modalContent.classList.remove('scale-95');
        }, 10);
      }
      function closeModal(modalEl) {
        if(!modalEl) return;
        const modalContentEl = modalEl.querySelector('.modal-content');
        modalEl.classList.add('opacity-0');
        if(modalContentEl) modalContentEl.classList.add('scale-95');
        setTimeout(() => {
          modalEl.classList.add('hidden');
        }, 300);
      }
      btnDeleteOpen.addEventListener('click', openModal);
      document.querySelectorAll('.modal-close, .modal-overlay').forEach(el => {
        el.addEventListener('click', (e) => {
          const m = e.target.closest('.fixed');
          if(m) closeModal(m);
        });
      });
      checkbox.addEventListener('change', (e) => {
        btnConfirmDelete.disabled = !e.target.checked;
      });
      btnConfirmDelete.addEventListener('click', async () => {
        btnConfirmDelete.disabled = true;
        btnConfirmDelete.textContent = i18n.deleting;
        try {
          const res = await fetch('/api/account/delete', { method: 'DELETE' });
          const data = await res.json();
          if (data.success) {
            if(window.showToast) window.showToast(i18n.delete_success, 'success');
            setTimeout(() => { window.location.href = '/login'; }, 1000);
          } else {
            if(window.showToast) window.showToast(data.error || i18n.delete_failed, 'error');
            btnConfirmDelete.disabled = false;
            btnConfirmDelete.textContent = i18n.confirm_delete;
          }
        } catch (err) {
          if(window.showToast) window.showToast(i18n.network_error, 'error');
          btnConfirmDelete.disabled = false;
          btnConfirmDelete.textContent = i18n.confirm_delete;
        }
      });
    });
  </script>
</Layout>

