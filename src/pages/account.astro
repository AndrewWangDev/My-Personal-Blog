  <script is:inline>
    (function() {
      try {
        const savedTab = localStorage.getItem('account_tab') || 'account';
        if (savedTab !== 'account') {
          const pAcc = document.getElementById('panel-account');
          if (pAcc) pAcc.classList.add('hidden');
          const pTgt = document.getElementById('panel-' + savedTab);
          if (pTgt) pTgt.classList.remove('hidden');

          const tAcc = document.getElementById('tab-account');
          if (tAcc) {
            tAcc.classList.remove('bg-blue-50', 'text-blue-700', 'dark:bg-blue-900/30', 'dark:text-blue-400');
            tAcc.classList.add('text-gray-600', 'hover:bg-gray-50', 'dark:text-slate-400', 'dark:hover:bg-slate-800');
          }
          const tTgt = document.getElementById('tab-' + savedTab);
          if (tTgt) {
            tTgt.classList.add('bg-blue-50', 'text-blue-700', 'dark:bg-blue-900/30', 'dark:text-blue-400');
            tTgt.classList.remove('text-gray-600', 'hover:bg-gray-50', 'dark:text-slate-400', 'dark:hover:bg-slate-800');
          }
        }
      } catch(e) {}
    })();
  </script>

  <script define:vars={{ i18n, googleClientId, hasPassword }}>
    document.addEventListener('DOMContentLoaded', () => {
      // ===== Custom Dialog Modal System (Alert, Confirm, Prompt) =====
      const dialogModal = document.getElementById('custom-dialog-modal');
      const dialogOverlay = document.getElementById('custom-dialog-overlay');
      const dialogContent = dialogModal?.querySelector('.relative');
      const dialogTitle = document.getElementById('custom-dialog-title');
      const dialogMessage = document.getElementById('custom-dialog-message');
      const dialogIconWrap = document.getElementById('custom-dialog-icon-wrap');
      const dialogIcon = document.getElementById('custom-dialog-icon');
      const dialogInputWrap = document.getElementById('custom-dialog-input-wrap');
      const dialogInput = document.getElementById('custom-dialog-input');
      const dialogBtnCancel = document.getElementById('custom-dialog-btn-cancel');
      const dialogBtnConfirm = document.getElementById('custom-dialog-btn-confirm');

      let dialogResolve = null;

      function closeCustomDialog(result) {
        if (!dialogModal) return;
        dialogModal.classList.add('opacity-0');
        if (dialogContent) dialogContent.classList.add('scale-95');
        setTimeout(() => {
          dialogModal.classList.add('hidden');
          if (dialogResolve) {
            dialogResolve(result);
            dialogResolve = null;
          }
        }, 150);
      }

      dialogOverlay?.addEventListener('click', () => closeCustomDialog(null));
      dialogBtnCancel?.addEventListener('click', () => closeCustomDialog(null));

      function openCustomDialog() {
        if (!dialogModal) return;
        dialogModal.classList.remove('hidden');
        setTimeout(() => {
          dialogModal.classList.remove('opacity-0');
          if (dialogContent) dialogContent.classList.remove('scale-95');
        }, 10);
      }

      function customAlert(title, message, type = 'info') {
        return new Promise((resolve) => {
          dialogResolve = resolve;
          if (dialogTitle) dialogTitle.innerText = title || i18n.notice || 'Notice';
          if (dialogMessage) dialogMessage.innerText = message || '';
          dialogInputWrap?.classList.add('hidden');
          dialogBtnCancel?.classList.add('hidden');
          if (dialogBtnConfirm) dialogBtnConfirm.innerText = i18n.ok || 'OK';

          if (type === 'error') {
            if (dialogIconWrap) dialogIconWrap.className = 'w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400';
            if (dialogIcon) dialogIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />';
            if (dialogBtnConfirm) dialogBtnConfirm.className = 'px-4 py-2 text-xs font-bold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-sm transition-all';
          } else if (type === 'warning') {
            if (dialogIconWrap) dialogIconWrap.className = 'w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-600 dark:text-yellow-400';
            if (dialogIcon) dialogIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />';
            if (dialogBtnConfirm) dialogBtnConfirm.className = 'px-4 py-2 text-xs font-bold text-white bg-yellow-600 hover:bg-yellow-700 rounded-xl shadow-sm transition-all';
          } else {
            if (dialogIconWrap) dialogIconWrap.className = 'w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400';
            if (dialogIcon) dialogIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />';
            if (dialogBtnConfirm) dialogBtnConfirm.className = 'px-4 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-all';
          }

          if (dialogBtnConfirm) dialogBtnConfirm.onclick = () => closeCustomDialog(true);
          openCustomDialog();
        });
      }

      function customConfirm(title, message, confirmText, type = 'warning') {
        return new Promise((resolve) => {
          dialogResolve = resolve;
          if (dialogTitle) dialogTitle.innerText = title || i18n.notice || 'Notice';
          if (dialogMessage) dialogMessage.innerText = message || '';
          dialogInputWrap?.classList.add('hidden');
          dialogBtnCancel?.classList.remove('hidden');
          if (dialogBtnCancel) dialogBtnCancel.innerText = i18n.cancel || 'Cancel';
          if (dialogBtnConfirm) dialogBtnConfirm.innerText = confirmText || i18n.ok || 'Confirm';

          if (type === 'danger') {
            if (dialogIconWrap) dialogIconWrap.className = 'w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400';
            if (dialogIcon) dialogIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />';
            if (dialogBtnConfirm) dialogBtnConfirm.className = 'px-4 py-2 text-xs font-bold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-sm transition-all';
          } else {
            if (dialogIconWrap) dialogIconWrap.className = 'w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-600 dark:text-yellow-400';
            if (dialogIcon) dialogIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />';
            if (dialogBtnConfirm) dialogBtnConfirm.className = 'px-4 py-2 text-xs font-bold text-white bg-yellow-600 hover:bg-yellow-700 rounded-xl shadow-sm transition-all';
          }

          if (dialogBtnConfirm) dialogBtnConfirm.onclick = () => closeCustomDialog(true);
          openCustomDialog();
        });
      }

      function customPrompt(title, message, defaultValue = '', placeholder = '') {
        return new Promise((resolve) => {
          dialogResolve = resolve;
          if (dialogTitle) dialogTitle.innerText = title || i18n.notice || 'Notice';
          if (dialogMessage) dialogMessage.innerText = message || '';
          dialogInputWrap?.classList.remove('hidden');
          if (dialogInput) {
            dialogInput.value = defaultValue;
            dialogInput.placeholder = placeholder || '';
          }
          dialogBtnCancel?.classList.remove('hidden');
          if (dialogBtnCancel) dialogBtnCancel.innerText = i18n.cancel || 'Cancel';
          if (dialogBtnConfirm) dialogBtnConfirm.innerText = i18n.ok || 'OK';

          if (dialogIconWrap) dialogIconWrap.className = 'w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400';
          if (dialogIcon) dialogIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />';
          if (dialogBtnConfirm) dialogBtnConfirm.className = 'px-4 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-all';

          const submitInput = () => {
            const val = dialogInput ? dialogInput.value.trim() : '';
            closeCustomDialog(val || null);
          };

          if (dialogBtnConfirm) dialogBtnConfirm.onclick = submitInput;
          if (dialogInput) {
            dialogInput.onkeydown = (e) => {
              if (e.key === 'Enter') submitInput();
              if (e.key === 'Escape') closeCustomDialog(null);
            };
          }

          openCustomDialog();
          setTimeout(() => dialogInput?.focus(), 50);
        });
      }

      const tabAccount = document.getElementById('tab-account');
      const tabBookmarks = document.getElementById('tab-bookmarks');
      const tabResources = document.getElementById('tab-resources');
      const tabComplaints = document.getElementById('tab-complaints');
      
      const panelAccount = document.getElementById('panel-account');
      const panelBookmarks = document.getElementById('panel-bookmarks');
      const panelResources = document.getElementById('panel-resources');
      const panelComplaints = document.getElementById('panel-complaints');
      
      let bookmarksLoaded = false;
      let resourcesLoaded = false;
      let complaintsLoaded = false;

      function switchTab(tab) {
        localStorage.setItem('account_tab', tab);
        const tabs = [tabAccount, tabBookmarks, tabResources, tabComplaints];
        const panels = [panelAccount, panelBookmarks, panelResources, panelComplaints];
        
        tabs.forEach(t => { 
          if(t) {
            t.classList.remove('bg-blue-50','text-blue-700','dark:bg-blue-900/30','dark:text-blue-400'); 
            t.classList.add('text-gray-600','hover:bg-gray-50','dark:text-slate-400','dark:hover:bg-slate-800'); 
          }
        });
        panels.forEach(p => p && p.classList.add('hidden'));

        if (tab === 'account') {
          tabAccount.classList.add('bg-blue-50','text-blue-700','dark:bg-blue-900/30','dark:text-blue-400');
          tabAccount.classList.remove('text-gray-600','hover:bg-gray-50','dark:text-slate-400','dark:hover:bg-slate-800');
          panelAccount.classList.remove('hidden');
        } else if (tab === 'bookmarks') {
          tabBookmarks.classList.add('bg-blue-50','text-blue-700','dark:bg-blue-900/30','dark:text-blue-400');
          tabBookmarks.classList.remove('text-gray-600','hover:bg-gray-50','dark:text-slate-400','dark:hover:bg-slate-800');
          panelBookmarks.classList.remove('hidden');
          if (!bookmarksLoaded) { loadBookmarks(); bookmarksLoaded = true; }
        } else if (tab === 'resources') {
          tabResources.classList.add('bg-blue-50','text-blue-700','dark:bg-blue-900/30','dark:text-blue-400');
          tabResources.classList.remove('text-gray-600','hover:bg-gray-50','dark:text-slate-400','dark:hover:bg-slate-800');
          panelResources.classList.remove('hidden');
          if (!resourcesLoaded) { loadResources(); resourcesLoaded = true; }
        } else if (tab === 'complaints') {
          tabComplaints.classList.add('bg-blue-50','text-blue-700','dark:bg-blue-900/30','dark:text-blue-400');
          tabComplaints.classList.remove('text-gray-600','hover:bg-gray-50','dark:text-slate-400','dark:hover:bg-slate-800');
          panelComplaints.classList.remove('hidden');
          if (!complaintsLoaded) { loadComplaints(); complaintsLoaded = true; }
        }
      }
      tabAccount?.addEventListener('click', () => switchTab('account'));
      tabBookmarks?.addEventListener('click', () => switchTab('bookmarks'));
      tabResources?.addEventListener('click', () => switchTab('resources'));
      tabComplaints?.addEventListener('click', () => switchTab('complaints'));
      
      const savedTab = localStorage.getItem('account_tab') || 'account';
      switchTab(savedTab);

      async function loadBookmarks() {
        const container = document.getElementById('bookmarks-list');
        try {
          const res = await fetch('/api/account/bookmarks');
          const data = await res.json();
          if (data.success && data.posts.length > 0) {
            container.innerHTML = data.posts.map(post => {
              const dateStr = new Date(post.created_at).toLocaleDateString('zh-CN');
              return `
                <a href="/blog/${post.id}" class="group block bg-gray-50 dark:bg-slate-800 rounded-2xl border border-gray-100 dark:border-slate-700 hover:shadow-md transition-all overflow-hidden">
                  <div class="flex flex-col sm:flex-row">
                    <div class="flex-1 p-5">
                      <h3 class="text-lg font-bold text-gray-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-1">${post.title}</h3>
                      <div class="flex items-center space-x-2 text-xs text-gray-400 dark:text-slate-500 mb-2">
