---
import { getLangFromRequest } from '../utils/lang';
import { ui, defaultLang } from '../i18n/ui';
const lang = getLangFromRequest(Astro);
const t = ui[lang as keyof typeof ui] || ui[defaultLang];

import Layout from '../layouts/Layout.astro';
import { env } from "cloudflare:workers";

if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

let userProfile = null;
try {
  const db = env.DB;
  if (db) {
    userProfile = await db.prepare('SELECT email, username, password_hash FROM users WHERE id = ?').bind(Astro.locals.user.id).first();
  }
} catch(e) {
  console.error("Failed to fetch user profile", e);
}

if (!userProfile) {
  return Astro.redirect('/login');
}

const hasPassword = Boolean(userProfile.password_hash);

// Prepare i18n strings for client-side
const i18n = {
  loading: t['account.loading'],
  no_bookmarks: t['account.no_bookmarks'],
  load_failed: t['account.load_failed'],
  pwd_strength: t['account.pwd_strength'],
  update_success: t['account.update_success'],
  network_error: t['account.network_error'],
  updating: t['account.updating'],
  save: t['account.save'],
  pwd_updating: t['account.pwd_updating'],
  pwd_success: t['account.pwd_success'],
  update_pwd: t['account.update_pwd'],
  set_pwd: t['account.set_pwd'] || '设置密码',
  set_pwd_desc: t['account.set_pwd_desc'] || '您当前使用第三方账号登录，尚未设置独立登录密码。设置密码后可使用邮箱和密码直接登录，并可自由解绑第三方账号。',
  pwd_set_success: t['account.pwd_set_success'] || '初始密码设置成功',
  logout: t['nav.logout'] || '退出登录',
  logout_confirm: t['account.logout_confirm'] || '确定要退出当前登录吗？',
  deleting: t['account.deleting'],
  delete_success: t['account.delete_success'],
  confirm_delete: t['account.confirm_delete'],
  delete_failed: t['account.delete_failed'],
  update_failed: t['account.update_failed'],
  resources: t['account.resources'],
  resources_desc: t['account.resources_desc'],
  no_resources: t['account.no_resources'],
  no_complaints: t['account.no_complaints'] || 'No complaints yet',
  connected_accounts: t['account.connected_accounts'] || 'Connected Accounts',
  connected_accounts_desc: t['account.connected_accounts_desc'] || 'Link accounts for fast login.',
  passkeys: t['account.passkeys'] || 'Passkeys',
  passkeys_desc: t['account.passkeys_desc'] || 'Passwordless biometrics login.',
  bind: t['account.bind'] || 'Connect',
  unbind: t['account.unbind'] || 'Disconnect',
  unbind_confirm: t['account.unbind_confirm'] || 'Are you sure you want to disconnect this account?',
  add_passkey: t['account.add_passkey'] || 'Add Passkey',
  passkey_name_prompt: t['account.passkey_name_prompt'] || 'Enter a name for this passkey:',
  delete_passkey_confirm: t['account.delete_passkey_confirm'] || 'Are you sure you want to delete this passkey?',
  no_passkeys: t['account.no_passkeys'] || 'No passkeys added yet',
  str_labels: [
    t['account.str_1'],
    t['account.str_2'],
    t['account.str_3'],
    t['account.str_4'],
    t['account.str_5']
  ],
  complaint_target: t['complaint.target'] || 'Target',
  complaint_reason: t['complaint.reason'] || 'Reason',
  complaint_details: t['complaint.details'] || 'Details',
  complaint_admin_response: t['complaint.admin_response'] || 'Admin Response',
  complaint_resolved: t['complaint.status_resolved'] || 'Resolved',
  complaint_pending: t['complaint.status_pending'] || 'Pending',
  complaint_revoke: t['complaint.revoke'] || 'Revoke',
  complaint_revoke_confirm: t['complaint.revoke_confirm'] || 'Are you sure?',
  reasons: {
    r1: t['complaint.r1'],
    r2: t['complaint.r2'],
    r3: t['complaint.r3'],
    r4: t['complaint.r4'],
    r5: t['complaint.r5'],
  },
  not_connected: t['account.not_connected'] || 'Not connected',
  connected: t['account.connected'] || 'Connected',
  checking_status: t['account.checking_status'] || 'Checking status...',
  google_loading: t['account.google_loading'] || 'Google service is loading, please try again in a moment',
  webauthn_unsupported: t['account.webauthn_unsupported'] || 'Your browser or device does not support Passkeys (WebAuthn)',
  passkey_add_success: t['account.passkey_add_success'] || 'Passkey created successfully!',
  google_bind_success: t['account.google_bind_success'] || 'Google account connected successfully',
  unbind_failed: t['account.unbind_failed'] || 'Failed to disconnect',
  ok: t['auth.ok'] || 'OK',
  cancel: t['account.cancel'] || 'Cancel',
  notice: t['auth.tip'] || 'Notice',
  delete: t['admin.btn_delete'] || 'Delete',
};

const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || '';

const googleLangMap: Record<string, string> = {
  'zh': 'zh-CN',
  'zh-tw': 'zh-TW',
  'en': 'en',
  'ja': 'ja',
  'de': 'de'
};
const googleLang = googleLangMap[lang] || 'zh-CN';
---

<Layout title={t['account.title'] + " | Andrew Wang Dev"}>
  <script is:inline src={`https://accounts.google.com/gsi/client?hl=${googleLang}`} async defer></script>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col md:flex-row min-h-[80vh] gap-8 relative">
    
    <aside class="w-full md:w-64 flex-shrink-0">
      <div class="md:sticky md:top-24 bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-800 p-2 md:p-6 flex md:flex-col overflow-x-auto md:overflow-x-visible space-x-2 md:space-x-0 md:space-y-1 no-scrollbar scroll-smooth">
        <div class="hidden md:block text-xs font-bold text-gray-400 dark:text-slate-500 uppercase tracking-wider mb-4">{t['account.title']}</div>
        <nav class="flex md:flex-col space-x-1.5 md:space-x-0 md:space-y-2 w-full min-w-max md:min-w-0">
          <button id="tab-account" aria-label="Account Tab" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 font-medium transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            <span>{t['account.manage']}</span>
          </button>
          <button id="tab-bookmarks" aria-label="Bookmarks Tab" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 dark:text-slate-400 hover:bg-gray-50 dark:hover:bg-slate-800 font-medium transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
            <span class="whitespace-nowrap">{t['account.bookmarks']}</span>
          </button>
          <button id="tab-resources" aria-label="Resources Tab" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 dark:text-slate-400 hover:bg-gray-50 dark:hover:bg-slate-800 font-medium transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
            <span class="whitespace-nowrap">{t['account.resources']}</span>
          </button>
          <button id="tab-complaints" aria-label="Complaints Tab" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 dark:text-slate-400 hover:bg-gray-50 dark:hover:bg-slate-800 font-medium transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            <span class="whitespace-nowrap">{t['account.complaints'] || '投诉工单'}</span>
          </button>
        </nav>
      </div>
    </aside>

    <main class="flex-1 bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-800 p-6 md:p-8">
      <div id="panel-account">
        <div class="mb-8 pb-4 border-b border-gray-100 dark:border-slate-800 flex items-center justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-slate-100">{t['account.manage']}</h1>
            <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">{t['account.manage_desc']}</p>
          </div>
          <button type="button" id="btn-logout-account" class="inline-flex items-center space-x-1.5 px-3.5 py-2 text-xs font-bold text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-950/40 hover:bg-red-100 dark:hover:bg-red-900/60 rounded-xl transition-all shadow-sm active:scale-95">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            <span>{t['nav.logout'] || '退出登录'}</span>
          </button>
        </div>

        <div class="space-y-10 max-w-3xl">
          <!-- Section 1: Basic Info -->
          <section>
            <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100 mb-4 flex items-center">
              <span class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center mr-3 text-sm font-bold">1</span>
              {t['account.basic_info']}
            </h2>
            <div class="bg-gray-50 dark:bg-slate-800 p-6 rounded-2xl border border-gray-100 dark:border-slate-700">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400 mb-2">{t['account.username']}</label>
                  <div class="px-4 py-2.5 bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100 border border-gray-200 dark:border-slate-700 rounded-xl text-sm font-medium shadow-sm">
                    {userProfile.username}
                  </div>
                  <p class="text-xs text-gray-400 dark:text-slate-500 mt-1.5">{t['account.username_desc']}</p>
                </div>
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400 mb-2">{t['account.email']}</label>
                  <div class="px-4 py-2.5 bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100 border border-gray-200 dark:border-slate-700 rounded-xl text-sm font-medium shadow-sm flex items-center justify-between">
                    <span>{userProfile.email}</span>
                    <span class="inline-flex items-center text-xs font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-2 py-0.5 rounded-md">Verified</span>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Section 2: Connected Accounts (OAuth) -->
          <section>
            <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100 mb-1 flex items-center">
              <span class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center mr-3 text-sm font-bold">2</span>
              {t['account.connected_accounts'] || '第三方账号绑定'}
            </h2>
            <p class="text-sm text-gray-500 dark:text-slate-400 mb-4 ml-11">{t['account.connected_accounts_desc'] || '绑定第三方账号以实现安全快捷登录。'}</p>
            
            <div id="oauth-accounts-container" class="space-y-3 bg-gray-50 dark:bg-slate-800 p-6 rounded-2xl border border-gray-100 dark:border-slate-700">
              <!-- Google Item -->
              <div class="flex items-center justify-between p-4 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 rounded-lg bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                      <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                      <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                      <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                      <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100">Google</h3>
                    <p id="google-status-text" class="text-xs text-gray-500 dark:text-slate-400">{i18n.checking_status}</p>
                  </div>
                </div>
                <div id="google-action-slot"></div>
              </div>

              <!-- GitHub Item -->
              <div class="flex items-center justify-between p-4 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 rounded-lg bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 flex items-center justify-center flex-shrink-0 text-gray-900 dark:text-white">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                  </div>
                  <div>
                    <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100">GitHub</h3>
                    <p id="github-status-text" class="text-xs text-gray-500 dark:text-slate-400">{i18n.checking_status}</p>
                  </div>
                </div>
                <div id="github-action-slot"></div>
              </div>
            </div>
          </section>

          <!-- Section 3: Passkeys Management -->
          <section>
            <div class="flex items-center justify-between mb-1">
              <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100 flex items-center">
                <span class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center mr-3 text-sm font-bold">3</span>
                {t['account.passkeys'] || '通行密钥 (Passkey)'}
              </h2>
              <button type="button" id="btn-add-passkey" class="inline-flex items-center space-x-1.5 px-3.5 py-1.5 text-xs font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 hover:bg-blue-100 dark:hover:bg-blue-900/60 rounded-xl transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                <span>{t['account.add_passkey'] || '添加通行密钥'}</span>
              </button>
            </div>
            <p class="text-sm text-gray-500 dark:text-slate-400 mb-4 ml-11">{t['account.passkeys_desc'] || '使用当前设备的指纹、面容或系统安全 PIN 码进行免密安全登录。'}</p>
            
            <div class="bg-gray-50 dark:bg-slate-800 p-6 rounded-2xl border border-gray-100 dark:border-slate-700">
              <div id="passkeys-list" class="space-y-3">
                <div class="text-center py-6 text-gray-400 text-xs">{t['account.loading']}</div>
              </div>
            </div>
          </section>

          <!-- Section 4: Security (Password) -->
          <section>
            <h2 class="text-lg font-bold text-gray-900 dark:text-slate-100 mb-4 flex items-center">
              <span class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center mr-3 text-sm font-bold">4</span>
              {t['account.security']}
            </h2>
            <form id="password-form" class="space-y-6 bg-gray-50 dark:bg-slate-800 p-6 rounded-2xl border border-gray-100 dark:border-slate-700">
              <div id="pwd-status-banner" class={hasPassword ? 'hidden' : 'p-4 bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-900/50 rounded-xl text-xs text-blue-800 dark:text-blue-300 leading-relaxed'}>
                {t['account.set_pwd_desc'] || '您当前使用第三方账号登录，尚未设置独立登录密码。设置密码后可使用邮箱和密码直接登录，并可自由解绑第三方账号。'}
              </div>
              <div id="group-old-password" class={hasPassword ? '' : 'hidden'}>
                <label class="block text-sm font-semibold text-gray-700 dark:text-slate-300 mb-2">{t['account.current_pwd']} <span class="text-red-500">*</span></label>
                <input type="password" name="oldPassword" id="acct-old-password" aria-label="Old Password Input" required={hasPassword} class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 text-gray-900 dark:text-slate-100 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all text-sm">
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 dark:text-slate-300 mb-2">{t['account.new_pwd']} <span class="text-red-500">*</span></label>
                <input type="password" name="newPassword" id="acct-new-password" aria-label="New Password Input" required minlength="6" class="w-full px-4 py-2.5 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 text-gray-900 dark:text-slate-100 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all text-sm">
                <div class="mt-2">
                  <div class="flex gap-1 h-1.5">
                    <div id="acct-str-1" class="flex-1 rounded-full bg-gray-200 dark:bg-slate-700 transition-colors duration-300"></div>
                    <div id="acct-str-2" class="flex-1 rounded-full bg-gray-200 dark:bg-slate-700 transition-colors duration-300"></div>
                    <div id="acct-str-3" class="flex-1 rounded-full bg-gray-200 dark:bg-slate-700 transition-colors duration-300"></div>
                    <div id="acct-str-4" class="flex-1 rounded-full bg-gray-200 dark:bg-slate-700 transition-colors duration-300"></div>
                    <div id="acct-str-5" class="flex-1 rounded-full bg-gray-200 dark:bg-slate-700 transition-colors duration-300"></div>
                  </div>
                  <p id="acct-str-label" class="text-xs mt-1 text-gray-400 dark:text-slate-500 transition-colors"></p>
                </div>
              </div>

              <div class="flex justify-end">
                <button type="submit" id="btn-save-password" class="px-6 py-2.5 text-sm font-bold text-white bg-gray-800 dark:bg-slate-700 rounded-xl hover:bg-black dark:hover:bg-slate-600 shadow-sm transition-all active:scale-95">{hasPassword ? t['account.update_pwd'] : (t['account.set_pwd'] || '设置密码')}</button>
              </div>
            </form>
          </section>

          <section>
            <h2 class="text-lg font-bold text-red-600 dark:text-red-400 mb-4 flex items-center">
              <span class="w-8 h-8 rounded-full bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 flex items-center justify-center mr-3 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              </span>
              {t['account.delete_account']}
            </h2>
            <div class="bg-red-50 dark:bg-red-900/10 p-6 rounded-2xl border border-red-100 dark:border-red-900/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <h3 class="font-bold text-red-900 dark:text-red-200 mb-1">{t['account.delete_my_account']}</h3>
                <p class="text-sm text-red-700/80 dark:text-red-400/80">{t['account.delete_desc']}</p>
              </div>
              <button type="button" id="btn-delete-account" class="whitespace-nowrap px-5 py-2.5 text-sm font-bold text-red-600 dark:text-red-400 bg-white dark:bg-slate-800 border border-red-200 dark:border-red-900/50 rounded-xl hover:bg-red-50 dark:hover:bg-red-900/30 hover:text-red-700 dark:hover:text-red-300 shadow-sm transition-all active:scale-95">{t['account.request_delete']}</button>
            </div>
          </section>
        </div>
      </div>

      <div id="panel-bookmarks" class="hidden max-w-3xl">
