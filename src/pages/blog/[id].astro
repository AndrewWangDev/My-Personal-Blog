---
import Layout from '../../layouts/Layout.astro';
import CommentSection from '../../components/CommentSection.astro';
import { env } from "cloudflare:workers";
import { getLangFromRequest } from '../../utils/lang';
import { ui, defaultLang } from '../../i18n/ui';
import { marked } from 'marked';

const { id } = Astro.params;
if (!id) return Astro.redirect('/404');

let post: any = null;
try {
  const db = env.DB;
  if (db) {
    post = await db.prepare('SELECT * FROM blog_posts WHERE id = ?').bind(id).first();
  }
} catch(e) {
  console.error("Failed to load blog post", e);
}

if (!post) return Astro.redirect('/404');

const htmlContent = post?.content ? await marked.parse(post.content) : '';

const lang = getLangFromRequest(Astro);
const t = ui[lang as keyof typeof ui] || ui[defaultLang];

const isLoggedIn = Astro.cookies.has('user_session');

---

<Layout title={post.title + " - Andrew Wang Dev"} description={post.summary || post.title} ogImage={post.thumbnail_url || '/fallback.png'}>
	<article class="bg-white dark:bg-slate-900 p-8 md:p-12 rounded-[2rem] shadow-sm border border-gray-100 dark:border-slate-800 max-w-4xl mx-auto">
		<h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-slate-100 tracking-tight mb-4">{post.title}</h1>
		<div class="mb-8 text-gray-500 dark:text-slate-400 border-b border-gray-100 dark:border-slate-800 pb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
			<div class="flex items-center space-x-3">
				<span class="bg-gray-50 dark:bg-slate-800 px-3 py-1 rounded-md text-sm font-medium">{t['blog.published_at']}：{new Date(post.created_at).toLocaleDateString(lang)}</span>
				<span class="bg-gray-50 dark:bg-slate-800 px-3 py-1 rounded-md text-sm font-medium text-gray-400 dark:text-slate-500">{t['blog.author']}：{post.author || 'Andrew Wang'}</span>
			</div>
			
			<div class="flex space-x-3 bg-gray-50 dark:bg-slate-800 p-1.5 rounded-xl border border-gray-100 dark:border-slate-700">
				<button id="like-btn" class="flex items-center space-x-1.5 text-gray-500 dark:text-slate-400 hover:text-red-500 dark:hover:text-red-400 transition-all bg-white dark:bg-slate-900 px-3 py-1.5 rounded-lg shadow-sm" data-post-id={id}>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
					<span id="like-count" class="font-bold text-sm">0</span>
				</button>
				<button id="bookmark-btn" aria-label={t['blog.bookmark']} class="flex items-center space-x-1.5 text-gray-500 dark:text-slate-400 hover:text-blue-500 dark:hover:text-blue-400 transition-all bg-white dark:bg-slate-900 px-3 py-1.5 rounded-lg shadow-sm" data-post-id={id} title={t['blog.bookmark']}>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
				</button>
				<button aria-label={t['complaint.btn']} onclick={`window.openComplaintModal('blog', '${id}')`} class="flex items-center space-x-1.5 text-red-500 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition-all bg-white dark:bg-slate-900 px-3 py-1.5 rounded-lg shadow-sm font-medium" title={t['complaint.btn']}>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
				</button>
			</div>
		</div>
		
		<div id="blog-content" class="prose prose-blue dark:prose-invert max-w-none text-gray-700 dark:text-slate-300 leading-relaxed mb-16" set:html={htmlContent}></div>
		
		<CommentSection targetId={`blog_${id}`} />
	</article>

	<script is:inline define:vars={{ 
		msgLikeSuccess: t['comments.like_success'],
		msgLikeCancel: t['comments.like_cancel'],
		msgBookmarkSuccess: t['comments.bookmark_success'],
		msgBookmarkCancel: t['comments.bookmark_cancel']
	}}>
		document.addEventListener('DOMContentLoaded', () => {

			const postId = document.getElementById('like-btn').dataset.postId;
			let isSubmitting = false;

			async function loadInteractions() {
				try {
					const likeRes = await fetch(`/api/interactions?target_type=post_like&target_id=blog_${postId}`);
					if(likeRes.ok) {
						const likeData = await likeRes.json();
						document.getElementById('like-count').textContent = likeData.total;
						const likeBtn = document.getElementById('like-btn');
						if(likeData.hasInteracted) {
							likeBtn.classList.add('text-red-500');
							likeBtn.querySelector('svg').setAttribute('fill', 'currentColor');
						} else {
							likeBtn.classList.remove('text-red-500');
							likeBtn.querySelector('svg').setAttribute('fill', 'none');
						}
					}
					
					const bookmarkRes = await fetch(`/api/interactions?target_type=post_bookmark&target_id=blog_${postId}`);
					if(bookmarkRes.ok) {
						const bookmarkData = await bookmarkRes.json();
						const bookmarkBtn = document.getElementById('bookmark-btn');
						if(bookmarkData.hasInteracted) {
							bookmarkBtn.classList.add('text-blue-500');
							bookmarkBtn.querySelector('svg').setAttribute('fill', 'currentColor');
						} else {
							bookmarkBtn.classList.remove('text-blue-500');
							bookmarkBtn.querySelector('svg').setAttribute('fill', 'none');
						}
					}
				} catch(e) {
					console.error("加载互动信息失败", e);
				}
			}
			
			async function toggleInteraction(type) {
				if(isSubmitting) return;
				isSubmitting = true;
				try {
					const res = await fetch('/api/interactions', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ targetType: type, targetId: `blog_${postId}` })
					});
					const data = await res.json();
					if(!data.success && data.error === '请先登录') {
						if(window.showToast) window.showToast('请先登录后再操作', 'error');
						setTimeout(() => window.location.href = '/login', 1000);
						return;
					}
					if(data.success) {
						await loadInteractions();
						if(window.showToast) {
							if(data.action === 'added') window.showToast(type === 'post_like' ? msgLikeSuccess : msgBookmarkSuccess, 'success');
							else window.showToast(type === 'post_like' ? msgLikeCancel : msgBookmarkCancel, 'info');
						}
					}
				} finally {
					setTimeout(() => { isSubmitting = false; }, 2000); // 2s throttle
				}
			}

			document.getElementById('like-btn').addEventListener('click', () => toggleInteraction('post_like'));
			document.getElementById('bookmark-btn').addEventListener('click', () => toggleInteraction('post_bookmark'));
			
			loadInteractions();
		});
	</script>
</Layout>
