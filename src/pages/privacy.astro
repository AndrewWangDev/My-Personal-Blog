---
import Layout from '../layouts/Layout.astro';
import { getLangFromRequest } from '../utils/lang';
import { ui, defaultLang } from '../i18n/ui';

const lang = getLangFromRequest(Astro);
const t = ui[lang as keyof typeof ui] || ui[defaultLang];

const content = {
  zh: {
    title: '隐私政策',
    updateDate: '最后更新日期：2026年05月11日',
    sections: [
      { h: '1. 引言', p: 'Andrew.Dev（以下简称“本网站”）尊重并保护您的个人隐私。本隐私政策旨在说明我们如何收集、使用和保护您的信息。本政策符合欧盟《通用数据保护条例》(GDPR) 和美国加州相关隐私法律（如 CCPA/CPRA）的要求。' },
      { h: '2. 我们收集的信息', p: '<ul><li><strong>2.1 账户信息：</strong>当您注册账户时，我们会收集您的用户名、邮箱地址以及密码哈希值。</li><li><strong>2.2 验证数据：</strong>为防止恶意攻击和刷取额度，我们使用 Cloudflare Turnstile 服务，该服务可能会收集您的浏览器环境指纹及非身份识别性技术数据。</li><li><strong>2.3 交互数据：</strong>我们会记录您在本网站发表的评论内容、点赞记录以及收藏条目。</li></ul>' },
      { h: '3. 数据处理的法律依据 (GDPR)', p: '我们根据以下法律依据处理您的个人数据：<ul><li><strong>履行合同：</strong>为您提供账户功能及资源管理服务所必须。</li><li><strong>正当利益：</strong>维护网站运行安全，防止恶意刷取 Cloudflare 免费计费额度。</li><li><strong>同意：</strong>当您自愿在个人中心填写非必填项或发表评论时。</li></ul>' },
      { h: '4. 您的权利', p: '<ul><li><strong>访问与更正权：</strong>您有权查看并修改您的账户信息。</li><li><strong>删除权（被遗忘权）：</strong>您有权要求删除您的账户及相关数据。</li><li><strong>拒绝销售数据：</strong>根据 CCPA，本网站承诺绝不向任何第三方出售、租赁或披露您的个人数据用于商业目的。</li></ul>' },
      { h: '5. 数据安全与留存', p: '我们使用 Cloudflare D1 数据库加密存储数据。除非法律要求或您主动要求删除，否则您的数据将一直保留至账户注销。<br/><br/><strong>特别说明（防滥用保护）：</strong>为防止恶意注册，当您注销账号后，我们会在专门的注销记录表中保存您的邮箱地址少量信息至少 1 个月，同一邮箱在一个月内仅能注册一次。当超出必要保护期限后，我们会彻底将其自动删除。' },
      { h: '6. 联系我们', p: '如果您对本政策有任何疑问，请发送邮件至：<span class="contact-email-trigger font-mono font-medium text-blue-600 dark:text-blue-400 cursor-pointer underline decoration-dotted" title="Click to copy email">support@andrewwangdev.com</span>' }
    ]
  },
  en: {
    title: 'Privacy Policy',
    updateDate: 'Last updated: May 11, 2026',
    sections: [
      { h: '1. Introduction', p: 'Andrew.Dev (hereinafter "the Website") respects and protects your personal privacy. This Privacy Policy explains how we collect, use, and protect your information. This policy complies with the EU General Data Protection Regulation (GDPR) and California privacy laws (such as CCPA/CPRA).' },
      { h: '2. Information We Collect', p: '<ul><li><strong>2.1 Account Information:</strong> When you register, we collect your username, email, and password hash.</li><li><strong>2.2 Verification Data:</strong> To prevent abuse, we use Cloudflare Turnstile, which may collect browser environment fingerprints and non-identifying technical data.</li><li><strong>2.3 Interaction Data:</strong> We record your comments, likes, and bookmarks on this website.</li></ul>' },
      { h: '3. Legal Basis for Data Processing (GDPR)', p: 'We process your personal data based on:<ul><li><strong>Contract Fulfillment:</strong> Necessary to provide account functions and resource management services.</li><li><strong>Legitimate Interest:</strong> Maintaining website operation security and preventing malicious resource consumption.</li><li><strong>Consent:</strong> When you voluntarily fill in optional fields or post comments.</li></ul>' },
      { h: '4. Your Rights', p: '<ul><li><strong>Right to Access and Correction:</strong> You have the right to view and modify your account info.</li><li><strong>Right to Erasure:</strong> You have the right to request deletion of your account and related data.</li><li><strong>No Sale of Data:</strong> Per CCPA, we commit to never sell, rent, or disclose your personal data to third parties for commercial purposes.</li></ul>' },
      { h: '5. Data Security and Retention', p: 'We use Cloudflare D1 database for encrypted storage. Your data remains until account deletion unless required by law.<br/><br/><strong>Special Note (Abuse Protection):</strong> To prevent malicious registration, upon account deletion, we retain minimal email info for at least 1 month to enforce registration limits. This info is automatically deleted after the necessary protection period.' },
      { h: '6. Contact Us', p: 'If you have questions about this policy, email: <span class="contact-email-trigger font-mono font-medium text-blue-600 dark:text-blue-400 cursor-pointer underline decoration-dotted" title="Click to copy email">support@andrewwangdev.com</span>' }
    ]
  },
  'zh-tw': {
    title: '隱私政策',
    updateDate: '最後更新日期：2026年05月11日',
    sections: [
      { h: '1. 引言', p: 'Andrew.Dev（以下簡稱「本網站」）尊重並保護您的個人隱私。本隱私政策旨在說明我們如何收集、使用和保護您的信息。本政策符合歐盟《通用數據保護條例》(GDPR) 和美國加州相關隱私法律（如 CCPA/CPRA）的要求。' },
      { h: '2. 我們收集的信息', p: '<ul><li><strong>2.1 帳戶信息：</strong>當您註冊帳戶時，我們會收集您的用戶名、郵箱地址以及密碼哈希值。</li><li><strong>2.2 驗證數據：</strong>為防止惡意攻擊和刷取額度，我們使用 Cloudflare Turnstile 服務，該服務可能會收集您的瀏覽器環境指紋及非身份識別性技術數據。</li><li><strong>2.3 交互數據：</strong>我們會記錄您在本網站發表的評論內容、點讚記錄以及收藏條目。</li></ul>' },
      { h: '3. 數據處理的法律依據 (GDPR)', p: '我們根據以下法律依據處理您的個人數據：<ul><li><strong>履行合同：</strong>為您提供帳戶功能及資源管理服務所必須。</li><li><strong>正當利益：</strong>維護網站運行安全，防止惡意刷取 Cloudflare 免費計費額度。</li><li><strong>同意：</strong>當您自願在個人中心填寫非必填項或發表評論時。</li></ul>' },
      { h: '4. 您的權利', p: '<ul><li><strong>訪問與更正權：</strong>您有權查看並修改您的帳戶信息。</li><li><strong>刪除權（被遺忘權）：</strong>您有權要求刪除您的帳戶及相關數據。</li><li><strong>拒絕銷售數據：</strong>根據 CCPA，本網站承諾絕不向任何第三方出售、租賃或披露您的個人數據用於商業目的。</li></ul>' },
      { h: '5. 數據安全與留存', p: '我們使用 Cloudflare D1 數據庫加密存儲數據。除非法律要求或您主動要求刪除，否則您的數據將一直保留至帳戶註銷。<br/><br/><strong>特別說明（防濫用保護）：</strong>為防止惡意註冊，當您註銷帳號後，我們會在專門的註銷記錄表中保存您的郵箱地址少量信息至少 1 個月，同一郵箱在一個月內僅能註冊一次。當超出必要保護期限後，我們會徹底將其自動刪除。' },
      { h: '6. 聯繫我們', p: '如果您對本政策有任何疑問，請發送郵件至：<span class="contact-email-trigger font-mono font-medium text-blue-600 dark:text-blue-400 cursor-pointer underline decoration-dotted" title="Click to copy email">support@andrewwangdev.com</span>' }
    ]
  },
  ja: {
    title: 'プライバシーポリシー',
    updateDate: '最終更新日：2026年05月11日',
    sections: [
      { h: '1. はじめに', p: 'Andrew.Dev（以下「当サイト」）は、ユーザーのプライバシーを尊重し、保護します。このプライバシーポリシーでは、情報の収集、使用、および保護の方法について説明します。本ポリシーは、EUの一般データ保護規則（GDPR）およびカリフォルニア州のプライバシー法（CCPA/CPRAなど）に準拠しています。' },
      { h: '2. 収集する情報', p: '<ul><li><strong>2.1 アカウント情報：</strong>登録時にユーザー名、メールアドレス、パスワードハッシュを収集します。</li><li><strong>2.2 検証データ：</strong>不正利用防止のためCloudflare Turnstileを使用しており、ブラウザ環境の指紋や非識別技術データが収集される場合があります。</li><li><strong>2.3 インタラクションデータ：</strong>当サイトでのコメント、いいね、ブックマークを記録します。</li></ul>' },
      { h: '3. データ処理の法的根拠 (GDPR)', p: '以下の理由に基づきデータを処理します：<ul><li><strong>契約履行：</strong>アカウント機能およびリソース管理サービスの提供に必要です。</li><li><strong>正当な利益：</strong>サイトの安全運用および不正利用防止のため。</li><li><strong>同意：</strong>任意項目への入力やコメント投稿時に同意を得たものとみなします。</li></ul>' },
      { h: '4. あなたの権利', p: '<ul><li><strong>アクセスと訂正：</strong>アカウント情報の確認と修正が可能です。</li><li><strong>消去権（忘れられる権利）：</strong>アカウントと関連データの削除をリクエストできます。</li><li><strong>データの販売拒否：</strong>CCPAに基づき、当サイトが個人データを第三者に販売することはありません。</li></ul>' },
      { h: '5. セキュリティと保持', p: 'Cloudflare D1で暗号化して保存します。アカウント削除まで保持されますが、法的に必要な場合はその限りではありません。<br/><br/><strong>不正利用防止について：</strong>アカウント削除後も、悪意のある再登録を防ぐため、最小限のメール情報を1ヶ月間保持します。この情報は期間経過後に自動削除されます。' },
      { h: '6. お問い合わせ', p: 'ご不明な点はメールでお問い合わせください：<span class="contact-email-trigger font-mono font-medium text-blue-600 dark:text-blue-400 cursor-pointer underline decoration-dotted" title="Click to copy email">support@andrewwangdev.com</span>' }
    ]
  },
  de: {
    title: 'Datenschutzerklärung',
    updateDate: 'Zuletzt aktualisiert: 11. Mai 2026',
    sections: [
      { h: '1. Einleitung', p: 'Andrew.Dev (im Folgenden "die Website") respektiert und schützt Ihre Privatsphäre. Diese Datenschutzerklärung erläutert, wie wir Ihre Daten erheben, verwenden und schützen. Diese Richtlinie entspricht der EU-Datenschutz-Grundverordnung (DSGVO) und den kalifornischen Datenschutzgesetzen (wie CCPA/CPRA).' },
      { h: '2. Informationen, die wir sammeln', p: '<ul><li><strong>2.1 Kontoinformationen:</strong> Bei der Registrierung erfassen wir Benutzername, E-Mail und Passwort-Hash.</li><li><strong>2.2 Verifizierungsdaten:</strong> Zur Missbrauchsprävention nutzen wir Cloudflare Turnstile, das Browser-Fingerprints und technische Daten erfassen kann.</li><li><strong>2.3 Interaktionsdaten:</strong> Wir protokollieren Kommentare, Likes und Lesezeichen auf dieser Website.</li></ul>' },
      { h: '3. Rechtsgrundlage für die Verarbeitung (DSGVO)', p: 'Wir verarbeiten Daten basierend auf:<ul><li><strong>Vertragserfüllung:</strong> Notwendig für Kontofunktionen und Ressourcenverwaltung.</li><li><strong>Berechtigtes Interesse:</strong> Sicherheit des Website-Betriebs und Prävention von Missbrauch.</li><li><strong>Einwilligung:</strong> Bei freiwilligen Angaben oder Kommentaren.</li></ul>' },
      { h: '4. Ihre Rechte', p: '<ul><li><strong>Auskunft und Berichtigung:</strong> Sie können Ihre Kontodaten einsehen und ändern.</li><li><strong>Löschung:</strong> Sie können die Löschung Ihres Kontos verlangen.</li><li><strong>Kein Verkauf von Daten:</strong> Gemäß CCPA verkaufen oder vermieten wir keine persönlichen Daten an Dritte.</li></ul>' },
      { h: '5. Datensicherheit und Aufbewahrung', p: 'Wir nutzen Cloudflare D1 zur verschlüsselten Speicherung. Daten bleiben bis zur Kontolöschung gespeichert, sofern keine gesetzlichen Aufbewahrungspflichten bestehen.<br/><br/><strong>Hinweis zum Missbrauchsschutz:</strong> Nach der Löschung speichern wir minimale E-Mail-Daten für 1 Monat, um Missbrauch zu verhindern. Diese werden danach automatisch gelöscht.' },
      { h: '6. Kontakt', p: 'Bei Fragen senden Sie eine E-Mail an: <span class="contact-email-trigger font-mono font-medium text-blue-600 dark:text-blue-400 cursor-pointer underline decoration-dotted" title="Click to copy email">support@andrewwangdev.com</span>' }
    ]
  }
};

const cur = content[lang as keyof typeof content] || content.zh;
---

<Layout title={`${cur.title} | Andrew Wang Dev`}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 pb-24">
    <div class="mb-12 border-b border-gray-100 dark:border-slate-800 pb-8 text-center">
      <h1 class="text-4xl font-black text-gray-900 dark:text-slate-100 tracking-tight mb-4 uppercase">{cur.title}</h1>
      <p class="text-lg text-gray-500 dark:text-slate-400 font-medium">{t['footer.privacy']}</p>
    </div>

    <article class="prose prose-blue prose-lg dark:prose-invert max-w-none bg-white dark:bg-slate-900 p-8 md:p-12 rounded-[2rem] shadow-sm border border-gray-100 dark:border-slate-800">
      <p class="text-gray-500 dark:text-slate-400 text-sm">{cur.updateDate}<br/>{t['footer.contact']}：<span class="contact-email-trigger font-mono font-medium text-blue-600 dark:text-blue-400 cursor-pointer underline decoration-dotted" title="Click to copy email">support@andrewwangdev.com</span></p>

      {cur.sections.map(s => (
        <section class="mt-8">
          <h3 class="font-bold text-gray-900 dark:text-slate-100 mb-4">{s.h}</h3>
          <div set:html={s.p} class="text-gray-600 dark:text-slate-300 leading-relaxed" />
        </section>
      ))}
    </article>
  </main>
</Layout>

<script is:inline define:vars={{ toastEmailCopiedMsg: t['toast.email_copied'] }}>
  document.querySelectorAll('.contact-email-trigger').forEach(el => {
    el.addEventListener('click', async () => {
      const email = ['support', '@', 'andrewwangdev.com'].join('');
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(email);
        } else {
          const input = document.createElement('input');
          input.value = email;
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
        }
        if (window.showToast) {
          const msg = toastEmailCopiedMsg || 'Email copied: ';
          window.showToast(`${msg}${email}`, 'success');
        }
      } catch (e) {
        if (window.showToast) {
          window.showToast(email, 'info');
        }
      }
    });
  });
</script>


