---
import Layout from '../layouts/Layout.astro';
import CommentSection from '../components/CommentSection.astro';
import { getLangFromRequest } from '../utils/lang';
import { ui, defaultLang } from '../i18n/ui';

const lang = getLangFromRequest(Astro);
const t = ui[lang as keyof typeof ui] || ui[defaultLang];
---

<Layout title={`${t['guestbook.title']} - Andrew Wang Dev`}>
  <div class="max-w-4xl mx-auto">
    <div class="mb-10">
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-slate-100 tracking-tight mb-3">{t['guestbook.title']}</h1>
      <p class="text-gray-500 dark:text-slate-400">{t['guestbook.desc']}</p>
    </div>

    <div class="bg-white dark:bg-slate-900 p-6 md:p-10 rounded-[2rem] shadow-sm border border-gray-100 dark:border-slate-800">
      <CommentSection targetId="guestbook" />
    </div>
  </div>
</Layout>

