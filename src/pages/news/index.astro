---
import Layout from '../../layouts/Layout.astro';
import { env } from "cloudflare:workers";
import { getLangFromRequest } from '../../utils/lang';
import { ui, defaultLang } from '../../i18n/ui';

const lang = getLangFromRequest(Astro);
const t = ui[lang as keyof typeof ui] || ui[defaultLang];

let newsList = [];
try {
  const db = env.DB;
  if(db) {
    const { results } = await db.prepare('SELECT id, title, author, thumbnail_url, content, created_at FROM news ORDER BY created_at DESC').all();
    newsList = results;
  }
} catch (e) {
  console.error("Failed to load news:", e);
}
---

<Layout 
  title={`${t['seo.news.title']} | Andrew Wang Dev`}
  description={t['seo.news.desc']}
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-12 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-slate-100 tracking-tight mb-2">{t['news.title']}</h1>
        <p class="text-gray-500 dark:text-slate-400 text-lg">{t['news.desc']}</p>
      </div>
      <a href="/rss.xml" target="_blank" class="inline-flex items-center space-x-2 bg-orange-50 dark:bg-orange-900/30 hover:bg-orange-100 dark:hover:bg-orange-900/50 text-orange-600 dark:text-orange-400 px-5 py-2.5 rounded-xl text-sm font-bold transition-all hover:-translate-y-0.5 shadow-sm border border-orange-100/50 dark:border-orange-900/50 w-max">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M4 11a9 9 0 019 9M4 4a16 16 0 0116 16M4 20h.01"></path></svg>
        <span>RSS Feed</span>
      </a>
    </div>

    {newsList.length === 0 ? (
      <div class="text-center text-gray-500 dark:text-slate-400 py-20 bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-gray-100 dark:border-slate-800">{t['home.no_posts']}</div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {newsList.map(item => {
          const date = new Date(item.created_at);
          const timeStr = `${date.getFullYear()}/${date.getMonth() + 1}/${date.getDate()}`;
          const summary = item.content ? item.content.replace(/[#*_\[\]()]/g, '').substring(0, 80) + '...' : t['home.read_more'] + '...';
          
          return (
            <a href={`/news/${item.id}`} aria-label={`${t['home.read_more']}: ${item.title}`} class="group bg-white dark:bg-slate-900 rounded-3xl shadow-sm hover:shadow-2xl hover:shadow-blue-500/10 dark:hover:shadow-none border border-gray-100 dark:border-slate-800 overflow-hidden transition-all duration-300 flex flex-col hover:-translate-y-1">
              <div class="aspect-[16/10] bg-gray-100 dark:bg-slate-800 relative overflow-hidden">
                {item.thumbnail_url ? (
                  <img src={item.thumbnail_url} alt="News Thumbnail" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" decoding="async" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-slate-800 dark:to-slate-700 text-blue-200 dark:text-slate-600">
                    <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
                  </div>
                )}
              </div>
              <div class="p-6 flex-1 flex flex-col">
                <div class="flex items-center text-xs text-gray-500 dark:text-slate-400 mb-3 space-x-3">
                  <span class="flex items-center"><svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>{timeStr}</span>
                  <span class="flex items-center"><svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>{item.author || 'Andrew'}</span>
                </div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-slate-100 mb-3 line-clamp-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{item.title}</h3>
                <p class="text-sm text-gray-500 dark:text-slate-400 line-clamp-3 mb-4 flex-1 leading-relaxed">{summary}</p>
                <div class="text-blue-600 dark:text-blue-400 text-sm font-semibold flex items-center group-hover:translate-x-1 transition-transform">
                  {t['home.read_more']} <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </div>
              </div>
            </a>
          )
        })}
      </div>
    )}
  </main>
</Layout>

