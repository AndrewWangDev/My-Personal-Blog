---
import Layout from '../../layouts/Layout.astro';
import CommentSection from '../../components/CommentSection.astro';
import { env } from "cloudflare:workers";
import { marked } from 'marked';
import { getLangFromRequest } from '../../utils/lang';
import { ui, defaultLang } from '../../i18n/ui';

const { id } = Astro.params;

let newsItem = null;
let htmlContent = '';

const lang = getLangFromRequest(Astro);
const t = ui[lang as keyof typeof ui] || ui[defaultLang];

try {
  const db = env.DB;
  if (db && id) {
    newsItem = await db.prepare('SELECT * FROM news WHERE id = ?').bind(id).first();
    if (newsItem && newsItem.content) {
      htmlContent = await marked.parse(newsItem.content);
    }
  }
} catch (e) {
  console.error("Failed to load news detail:", e);
}

if (!newsItem) {
  return Astro.redirect('/404');
}

const date = new Date(newsItem.created_at);
const timeStr = `${date.getFullYear()}/${date.getMonth() + 1}/${date.getDate()}`;

---

<Layout title={`${newsItem.title} | ${t['nav.news']}`} description={newsItem.content ? newsItem.content.replace(/[#*_\[\]()]/g, '').substring(0, 160) + '...' : newsItem.title} ogImage={newsItem.cover_url || newsItem.thumbnail_url || '/fallback.png'}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 pb-20">
    
    <div class="mb-8">
      <a href="/news" aria-label="Back to News" class="inline-flex items-center text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors bg-white dark:bg-slate-900 px-4 py-2 rounded-full shadow-sm border border-gray-100 dark:border-slate-800">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        {t['news.back']}
      </a>
    </div>

    <article class="bg-white dark:bg-slate-900 rounded-[2rem] shadow-sm border border-gray-100 dark:border-slate-800 overflow-hidden">
      {newsItem.cover_url && (
        <div class="w-full h-64 md:h-96 relative">
          <img src={newsItem.cover_url} alt="News Cover" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 to-transparent"></div>
        </div>
      )}
      
      <div class="p-8 md:p-12 relative">
        <!-- Title and Meta -->
        <div class="mb-10 text-center max-w-2xl mx-auto">
          <h1 class="text-3xl md:text-5xl font-black text-gray-900 dark:text-slate-100 tracking-tight leading-tight mb-6">{newsItem.title}</h1>
          <div class="flex items-center justify-center space-x-4 text-sm font-medium text-gray-500 dark:text-slate-400">
            <span class="flex items-center bg-gray-50 dark:bg-slate-800 px-3 py-1.5 rounded-full">
              <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              {newsItem.author}
            </span>
            <span class="flex items-center bg-gray-50 dark:bg-slate-800 px-3 py-1.5 rounded-full">
              <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              {t['blog.published_at']}：{timeStr}
            </span>
          </div>
        </div>

        <div class="flex justify-end mb-8 border-b border-gray-100 dark:border-slate-800 pb-4">
          <button aria-label={t['complaint.btn']} onclick={`window.openComplaintModal('news', '${id}')`} class="flex items-center space-x-1.5 text-red-500 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition-all bg-gray-50 dark:bg-slate-800 px-3 py-1.5 rounded-lg shadow-sm font-medium" title={t['complaint.btn']}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            <span class="text-sm font-medium">{t['complaint.btn']}</span>
          </button>
        </div>

        <!-- Markdown Content -->
        <!-- Use prose class for styling the markdown content -->
        <div class="prose prose-lg prose-blue dark:prose-invert max-w-none mx-auto prose-headings:font-bold prose-img:rounded-xl prose-img:shadow-sm" set:html={htmlContent}>
        </div>
      </div>
    </article>

    <div class="mt-16">
      <CommentSection targetId={`news_${newsItem.id}`} />
    </div>

  </main>
</Layout>

