---
import Layout from '../../layouts/Layout.astro';
import CommentSection from '../../components/CommentSection.astro';
import { env } from "cloudflare:workers";
import { marked } from 'marked';
import { getLangFromRequest } from '../../utils/lang';
import { ui, defaultLang } from '../../i18n/ui';

const { id } = Astro.params;
const db = env.DB;

let resource = null;
try {
  resource = await db.prepare('SELECT * FROM resources WHERE id = ?').bind(id).first();
} catch (error) {
  console.error("Error fetching resource details:", error);
}

if (!resource) {
  return Astro.redirect('/404');
}

const tags = (() => {
  try { return JSON.parse(resource.tags || '[]'); } 
  catch { return []; }
})();

const lang = getLangFromRequest(Astro);
const t = ui[lang as keyof typeof ui] || ui[defaultLang];

const hasExternalLink = !!resource.github_url;
const primaryLink = resource.github_url || resource.download_url || '#';

let htmlContent = '';
if (resource.details) {
  htmlContent = await marked.parse(resource.details);
}

// 读取登录状态
const isLoggedIn = Astro.cookies.has('user_session');
Astro.response.headers.set('Cache-Control', 'public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400');
---

<Layout title={`${resource.name} | Andrew Wang Dev`} description={resource.summary || resource.name} ogImage={resource.cover_image_url || resource.logo_url || '/fallback.png'}>
	<article class="max-w-4xl mx-auto py-8 px-4 sm:px-0">
		<!-- Header Section -->
		<div class="flex flex-col md:flex-row gap-8 mb-12">
			<!-- Logo Box -->
			<div class="w-32 h-32 md:w-40 md:h-40 flex-shrink-0 bg-white dark:bg-slate-900 rounded-[2rem] shadow-xl border border-gray-100 dark:border-slate-800 flex items-center justify-center overflow-hidden self-center md:self-start">
				{resource.logo_url ? (
					<img src={resource.logo_url} alt="Resource Logo" class="w-full h-full object-cover" />
				) : (
					<span class="text-6xl font-black text-gray-200 dark:text-slate-700 tracking-tighter">{resource.name.substring(0, 2).toUpperCase()}</span>
				)}
			</div>

			<!-- Info -->
			<div class="flex-1 flex flex-col justify-center text-center md:text-left">
				<h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-slate-100 tracking-tight mb-2">{resource.name}</h1>
				<p class="text-[13px] text-gray-400 dark:text-slate-500 font-medium mb-2">{t['res.author']}：{resource.author || 'Andrew Wang'}</p>
				<p class="text-gray-500 dark:text-slate-400 mb-6">{resource.summary}</p>
				
				<div class="flex flex-col sm:flex-row items-center gap-4 justify-center md:justify-start">
					<div class="flex flex-wrap gap-4">
						{resource.github_url && (
							<a href={resource.github_url} target="_blank" class="bg-gray-900 dark:bg-slate-700 hover:bg-black dark:hover:bg-slate-600 text-white px-8 py-3.5 rounded-2xl font-bold transition shadow-lg active:scale-95 flex items-center gap-2">
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.416-4.041-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
								{t['res.github']}
							</a>
						)}
						{resource.download_url && (
							<a href={resource.download_url} target="_blank" class="bg-blue-600 dark:bg-blue-500 hover:bg-blue-700 dark:hover:bg-blue-600 text-white px-8 py-3.5 rounded-2xl font-bold transition shadow-lg shadow-blue-500/20 active:scale-95 flex items-center gap-2">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
								{t['res.download']}
							</a>
						)}
					</div>
				</div>
			</div>
		</div>

		<!-- Divider -->
		<hr class="border-gray-100 dark:border-slate-800 my-8" />

		<!-- Tags & Metadata -->
		<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-10 bg-white dark:bg-slate-900 p-4 rounded-2xl border border-gray-100 dark:border-slate-800 shadow-sm">
			<div class="flex flex-wrap gap-2 mb-4 sm:mb-0">
				{tags.length > 0 ? tags.map((tag: string) => (
					<span class="px-3 py-1 bg-gray-50 dark:bg-slate-800 text-gray-700 dark:text-slate-300 rounded-lg text-sm font-medium border border-gray-200 dark:border-slate-700">{tag}</span>
				)) : (
					<span class="text-sm text-gray-400 dark:text-slate-500">{t['res.no_tags']}</span>
				)}
			</div>
			<div class="flex items-center space-x-4">
				<div class="text-sm text-gray-400 dark:text-slate-500 font-medium">
					{t['blog.published_at']} {new Date(resource.created_at).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
				</div>
				<button aria-label={t['complaint.btn']} onclick={`window.openComplaintModal('resource', '${id}')`} class="flex items-center space-x-1.5 text-red-500 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition-all bg-gray-50 dark:bg-slate-800 px-3 py-1 text-xs rounded-lg shadow-sm border border-gray-100 dark:border-slate-700 font-medium" title={t['complaint.btn']}>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
					<span class="font-medium">{t['complaint.btn']}</span>
				</button>
			</div>
		</div>

		<!-- Cover Image (Optional Carousel placeholder) -->
		{resource.cover_image_url && (
			<div class="mb-12 rounded-[2rem] overflow-hidden shadow-2xl border border-gray-100 dark:border-slate-800 bg-gray-50 dark:bg-slate-800 aspect-video flex items-center justify-center">
				<img src={resource.cover_image_url} alt="Resource Cover" class="w-full h-full object-cover" />
			</div>
		)}

		<!-- Details Content -->
		<div class="bg-white dark:bg-slate-900 rounded-[2rem] p-8 md:p-12 shadow-sm border border-gray-100 dark:border-slate-800">

			<div class="flex justify-between items-center mb-6">
				<h2 class="text-2xl font-bold text-gray-900 dark:text-slate-100">{t['res.intro']}</h2>
				<div class="flex space-x-3 bg-gray-50 dark:bg-slate-800 p-1.5 rounded-xl border border-gray-100 dark:border-slate-700">
					<button id="like-btn" aria-label={t['res.like']} title={t['res.like']} class="flex items-center space-x-1.5 text-gray-500 dark:text-slate-400 hover:text-red-500 dark:hover:text-red-400 transition-all bg-white dark:bg-slate-900 px-3 py-1.5 rounded-lg shadow-sm border border-transparent dark:border-slate-700" data-post-id={`res_${id}`}>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
						<span id="like-count" class="font-bold text-sm">0</span>
					</button>
					<button id="bookmark-btn" aria-label={t['res.bookmark']} title={t['res.bookmark']} class="flex items-center space-x-1.5 text-gray-500 dark:text-slate-400 hover:text-blue-500 dark:hover:text-blue-400 transition-all bg-white dark:bg-slate-900 px-3 py-1.5 rounded-lg shadow-sm border border-transparent dark:border-slate-700" data-post-id={`res_${id}`}>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
					</button>
				</div>
			</div>
			<div class="prose prose-blue dark:prose-invert max-w-none text-gray-600 dark:text-slate-400 leading-relaxed mb-16" set:html={htmlContent || `<p class="text-gray-400 dark:text-slate-500 italic">${t['res.no_intro']}</p>`}>
			</div>

			<CommentSection targetId={`res_${id}`} />
		</div>
	</article>

	<script is:inline define:vars={{
		msgLikeSuccess: t['comments.like_success'],
		msgLikeCancel: t['comments.like_cancel'],
		msgBookmarkSuccess: t['comments.bookmark_success'],
		msgBookmarkCancel: t['comments.bookmark_cancel']
	}}>
		document.addEventListener('DOMContentLoaded', () => {
			const postId = document.getElementById('like-btn').dataset.postId;
			let isSubmitting = false;

			async function loadInteractions() {
				try {
					const likeRes = await fetch(`/api/interactions?target_type=resource_like&target_id=${postId}`);
					if(likeRes.ok) {
						const likeData = await likeRes.json();
						document.getElementById('like-count').textContent = likeData.total;
						const likeBtn = document.getElementById('like-btn');
						if(likeData.hasInteracted) {
							likeBtn.classList.add('text-red-500');
							likeBtn.querySelector('svg').setAttribute('fill', 'currentColor');
						} else {
							likeBtn.classList.remove('text-red-500');
							likeBtn.querySelector('svg').setAttribute('fill', 'none');
						}
					}
					
					const bookmarkRes = await fetch(`/api/interactions?target_type=resource_bookmark&target_id=${postId}`);
					if(bookmarkRes.ok) {
						const bookmarkData = await bookmarkRes.json();
						const bookmarkBtn = document.getElementById('bookmark-btn');
						if(bookmarkData.hasInteracted) {
							bookmarkBtn.classList.add('text-blue-500');
							bookmarkBtn.querySelector('svg').setAttribute('fill', 'currentColor');
						} else {
							bookmarkBtn.classList.remove('text-blue-500');
							bookmarkBtn.querySelector('svg').setAttribute('fill', 'none');
						}
					}
				} catch(e) {
					console.error("加载互动信息失败", e);
				}
			}
			
			async function toggleInteraction(type, btnId) {
				if(isSubmitting) return;
				isSubmitting = true;
				try {
					const res = await fetch('/api/interactions', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ targetType: type, targetId: postId })
					});
					const data = await res.json();
					if(!data.success && data.error === '请先登录') {
						if(window.showToast) window.showToast('请先登录后再操作', 'error');
						setTimeout(() => window.location.href = '/login', 1000);
						return;
					}
					if(data.success) {
						await loadInteractions();
						if(window.showToast) {
							if(data.action === 'added') window.showToast(type === 'resource_like' ? msgLikeSuccess : msgBookmarkSuccess, 'success');
							else window.showToast(type === 'resource_like' ? msgLikeCancel : msgBookmarkCancel, 'info');
						}
					}
				} finally {
					isSubmitting = false;
				}
			}

			document.getElementById('like-btn').addEventListener('click', () => toggleInteraction('resource_like', 'like-btn'));
			document.getElementById('bookmark-btn').addEventListener('click', () => toggleInteraction('resource_bookmark', 'bookmark-btn'));
			
			loadInteractions();
		});
	</script>
</Layout>

