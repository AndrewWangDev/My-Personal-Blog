# ==============================================================================
# Astro Frontend Environment Variables (.env.example)
#
# Instructions:
# 1. Copy this file to `.env`:
#    cp .env.example .env
# 2. Fill in your actual credentials.
# Note: Variables prefixed with PUBLIC_ are exposed to the browser bundle during build.
# ==============================================================================

# Cloudflare Turnstile CAPTCHA (Site Key)
# Obtained from: Cloudflare Dashboard -> Turnstile -> Add site (Visible to browser)
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxxx

# Google OAuth 2.0 Web Client ID
# Obtained from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GitHub OAuth App Client ID (Optional public fallback)
# Obtained from: GitHub -> Settings -> Developer settings -> OAuth Apps
# PUBLIC_GITHUB_CLIENT_ID=your_github_client_id
